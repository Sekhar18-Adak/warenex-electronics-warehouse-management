<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body { background: #f5f7fb; color: #17324d; }
      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
      }
      .navbar {
        position: sticky;
        top: 0;
        z-index: 1030;
      }
      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }
      .sidebar .nav-link:hover {
        background-color: #eef4ff;
        color: #0d6efd;
      }
      .module-card {
        border: 1px solid #e7ebf0;
        border-radius: 16px;
      }
      .table-card { border-radius: 12px; }
      .status-badge { border-radius: 999px; }
    </style>
  </head>
  <body>
    <% const isAdminView = inventoryBasePath === '/admin'; %>
    <header class="navbar navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="<%= isAdminView ? '/admin/dashboard' : '/manager/dashboard' %>"><%= isAdminView ? 'Admin Workspace' : 'Manager Workspace' %></a>
        <div class="d-flex gap-3 align-items-center">
          <div class="text-muted small">Signed in as <strong><%= user?.name || (isAdminView ? 'Administrator' : 'Manager') %></strong></div>
          <form action="<%= isAdminView ? '/admin/logout' : '/logout' %>" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4" style="padding-bottom: 2rem;">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2"><%= isAdminView ? 'Admin Menu' : 'Manager Menu' %></div>
            <nav class="nav flex-column gap-1">
              <% if (isAdminView) { %>
                <a class="nav-link px-3 py-2" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                <a class="nav-link px-3 py-2" href="/admin/employee"><i class="bi bi-people me-2"></i>Employees</a>
                <a class="nav-link px-3 py-2" href="/admin/inventory"><i class="bi bi-stack me-2"></i>Inventory</a>
                <a class="nav-link px-3 py-2" href="/admin/tasks"><i class="bi bi-list-check me-2"></i>Tasks</a>
                <a class="nav-link px-3 py-2" href="/admin/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
                <a class="nav-link px-3 py-2" href="/admin/suppliers"><i class="bi bi-truck me-2"></i>Suppliers</a>
                <a class="nav-link px-3 py-2" href="/admin/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <% } else { %>
                <a class="nav-link px-3 py-2" href="/manager/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                <a class="nav-link px-3 py-2" href="/manager/products"><i class="bi bi-box-seam me-2"></i>Products</a>
                <a class="nav-link px-3 py-2" href="/manager/inventory"><i class="bi bi-stack me-2"></i>Inventory</a>
                <a class="nav-link px-3 py-2" href="/manager/purchases"><i class="bi bi-cart3 me-2"></i>Purchases</a>
                <a class="nav-link px-3 py-2" href="/manager/suppliers"><i class="bi bi-truck me-2"></i>Suppliers</a>
                <a class="nav-link px-3 py-2" href="/manager/tasks"><i class="bi bi-list-check me-2"></i>Assign Tasks</a>
                <a class="nav-link px-3 py-2" href="/manager/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
                <a class="nav-link px-3 py-2" href="/manager/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
                <a class="nav-link px-3 py-2" href="/manager/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
              <% } %>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <% if (notice) { %>
            <div class="alert alert-info alert-dismissible fade show" role="alert">
              <%= notice %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0"><%= isAdminView ? 'Inventory Overview' : 'Inventory' %></h1>
            <div>
              <% if (!isAdminView) { %>
                <a href="<%= inventoryBasePath %>/inventory/add" class="btn btn-primary btn-sm">+ Add Product</a>
              <% } %>
            </div>
          </div>

          <% if (isAdminView) { %>
            <div class="row g-3 mb-4">
              <div class="col-sm-6 col-xl-4">
                <div class="card module-card h-100 shadow-sm">
                  <div class="card-body">
                    <div class="text-primary fs-3 mb-2"><i class="bi bi-box-seam"></i></div>
                    <div class="summary-label text-muted mb-2">Total Products</div>
                    <div class="display-6 fw-semibold"><%= summary.totalItems %></div>
                  </div>
                </div>
              </div>
              <div class="col-sm-6 col-xl-4">
                <div class="card module-card h-100 shadow-sm">
                  <div class="card-body">
                    <div class="text-danger fs-3 mb-2"><i class="bi bi-exclamation-octagon"></i></div>
                    <div class="summary-label text-muted mb-2">Out of Stock Products</div>
                    <div class="display-6 fw-semibold"><%= summary.outOfStockItems %></div>
                  </div>
                </div>
              </div>
              <div class="col-sm-6 col-xl-4">
                <div class="card module-card h-100 shadow-sm">
                  <div class="card-body">
                    <div class="text-warning fs-3 mb-2"><i class="bi bi-exclamation-triangle"></i></div>
                    <div class="summary-label text-muted mb-2">Low Stock Products</div>
                    <div class="display-6 fw-semibold"><%= summary.lowStockItems %></div>
                  </div>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="row g-3 mb-4">
              <div class="col-sm-6 col-xl-4">
                <div class="card module-card h-100 shadow-sm">
                  <div class="card-body">
                    <div class="text-primary fs-3 mb-2"><i class="bi bi-box-seam"></i></div>
                    <div class="summary-label text-muted mb-2">Total Products</div>
                    <div class="display-6 fw-semibold"><%= summary.totalItems %></div>
                    <a href="<%= inventoryBasePath %>/inventory?view=critical" class="btn btn-outline-primary btn-sm mt-3 <%= activeView === 'critical' ? 'disabled' : '' %>">View</a>
                  </div>
                </div>
              </div>
              <div class="col-sm-6 col-xl-4">
                <div class="card module-card h-100 shadow-sm">
                  <div class="card-body">
                    <div class="text-warning fs-3 mb-2"><i class="bi bi-exclamation-triangle"></i></div>
                    <div class="summary-label text-muted mb-2">Low Stock Products</div>
                    <div class="display-6 fw-semibold"><%= summary.lowStockItems %></div>
                    <a href="<%= inventoryBasePath %>/inventory?view=lowstock" class="btn btn-outline-primary btn-sm mt-3 <%= activeView === 'lowstock' ? 'disabled' : '' %>">View</a>
                  </div>
                </div>
              </div>
              <div class="col-sm-6 col-xl-4">
                <div class="card module-card h-100 shadow-sm">
                  <div class="card-body">
                    <div class="text-danger fs-3 mb-2"><i class="bi bi-exclamation-octagon"></i></div>
                    <div class="summary-label text-muted mb-2">Out of Stock Products</div>
                    <div class="display-6 fw-semibold"><%= summary.outOfStockItems %></div>
                    <a href="<%= inventoryBasePath %>/inventory?view=outofstock" class="btn btn-outline-primary btn-sm mt-3 <%= activeView === 'outofstock' ? 'disabled' : '' %>">View</a>
                  </div>
                </div>
              </div>
            </div>
          <% } %>

          <div class="card border-0 shadow-sm table-card">
            <div class="card-body p-3">
              <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-3">
                <div>
                  <h2 class="h5 mb-1"><%= filterLabel %></h2>
                  <p class="text-muted mb-0">Showing <strong><%= products.length %></strong> product<%= products.length === 1 ? '' : 's' %>.</p>
                </div>
                <% if (!isAdminView) { %>
                  <a href="<%= inventoryBasePath %>/inventory?view=critical" class="btn btn-outline-secondary btn-sm">Reset filter</a>
                <% } %>
              </div>

              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Product Code</th>
                      <% if (isAdminView) { %>
                        <th>Purchase Price</th>
                        <th>Selling Price</th>
                        <th>Current Stock</th>
                        <th>Action</th>
                      <% } else { %>
                        <th>Product Name</th>
                        <th>Current Stock</th>
                        <th>Minimum Stock</th>
                        <th>Status</th>
                        <th>Update</th>
                      <% } %>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!products || !products.length) { %>
                      <tr>
                        <td colspan="<%= isAdminView ? 5 : 6 %>" class="text-center text-muted py-4">No products found.</td>
                      </tr>
                    <% } else { %>
                      <% products.forEach((p) => { %>
                        <tr>
                          <td><%= p.code %></td>
                          <% if (isAdminView) { %>
                            <td>Rs. <%= Number(p.purchasePrice || 0).toLocaleString('en-LK', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                            <td>Rs. <%= Number(p.sellingPrice || 0).toLocaleString('en-LK', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                            <td><%= p.currentStock %></td>
                            <td>
                              <span class="badge bg-light text-dark"><%= p.status %></span>
                            </td>
                          <% } else { %>
                            <td><%= p.name %></td>
                            <td><%= p.currentStock %></td>
                            <td><%= p.minimumStock %></td>
                            <td><span class="badge status-badge <%= p.statusClass %>"><%= p.status %></span></td>
                            <td>
                              <form action="<%= inventoryBasePath %>/inventory/update/<%= p.id %>" method="post" class="d-flex flex-column gap-2" style="min-width: 220px;">
                                <input type="number" class="form-control form-control-sm" name="currentStock" value="<%= p.currentStock %>" min="0" required />
                                <input type="number" class="form-control form-control-sm" name="minimumStock" value="<%= p.minimumStock %>" min="0" required />
                                <select class="form-select form-select-sm" name="status" required>
                                  <option value="Active" <%= p.rawStatus === 'Active' ? 'selected' : '' %>>Active</option>
                                  <option value="Inactive" <%= p.rawStatus === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                                  <option value="Discontinued" <%= p.rawStatus === 'Discontinued' ? 'selected' : '' %>>Discontinued</option>
                                </select>
                                <button type="submit" class="btn btn-primary btn-sm">Update</button>
                              </form>
                            </td>
                          <% } %>
                        </tr>
                      <% }); %>
                    <% } %>
                  </tbody>
                </table>
              </div>

              <% if (!isAdminView && typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <span class="text-muted small">Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong></span>
                  <div class="btn-group" role="group" aria-label="Pagination">
                    <a href="<%= inventoryBasePath %>/inventory?view=<%= view %>&page=<%= Math.max(1, currentPage - 1) %>" class="btn btn-outline-secondary btn-sm <%= currentPage <= 1 ? 'disabled' : '' %>" aria-disabled="<%= currentPage <= 1 %>">
                      <i class="bi bi-chevron-left"></i>
                    </a>
                    <a href="<%= inventoryBasePath %>/inventory?view=<%= view %>&page=<%= Math.min(totalPages, currentPage + 1) %>" class="btn btn-outline-secondary btn-sm <%= currentPage >= totalPages ? 'disabled' : '' %>" aria-disabled="<%= currentPage >= totalPages %>">
                      <i class="bi bi-chevron-right"></i>
                    </a>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

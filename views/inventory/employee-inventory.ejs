<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
        padding-bottom: 2rem;
      }

      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .table-card {
        border: 1px solid #e7ebf0;
        border-radius: 18px;
        background: #fff;
        overflow: hidden;
      }

      .status-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.38rem 0.7rem;
        border-radius: 999px;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/employee/dashboard">Employee Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="d-flex align-items-center gap-2 text-muted small">
            <% if (user?.profile_image) { %>
              <img src="<%= user.profile_image %>" alt="Profile image" class="rounded-circle border" style="width: 28px; height: 28px; object-fit: cover;" />
            <% } else { %>
              <div class="rounded-circle border bg-light d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                <i class="bi bi-person-fill text-secondary"></i>
              </div>
            <% } %>
            <span>Signed in as <strong><%= user?.name || 'Employee' %></strong></span>
          </div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Employee Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/employee/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
              <a class="nav-link px-3 py-2 active" href="/employee/inventory"><i class="bi bi-box-seam me-2"></i>Inventory View</a>
              <a class="nav-link px-3 py-2" href="/employee/tasks"><i class="bi bi-list-check me-2"></i>Assigned Tasks</a>
              <a class="nav-link px-3 py-2" href="/employee/profile"><i class="bi bi-person-circle me-2"></i>My Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
            <div>
              <h1 class="h3 fw-semibold mb-1">Inventory Overview</h1>
              <p class="text-muted mb-0">Current product stock and availability across the warehouse.</p>
            </div>
            <a href="/employee/dashboard" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                  <div class="small text-uppercase text-muted">Total Products</div>
                  <div class="display-6 fw-semibold mt-2"><%= summary.totalItems %></div>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                  <div class="small text-uppercase text-muted">Low Stock</div>
                  <div class="display-6 fw-semibold mt-2 text-warning"><%= summary.lowStockItems %></div>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                  <div class="small text-uppercase text-muted">Out of Stock</div>
                  <div class="display-6 fw-semibold mt-2 text-danger"><%= summary.outOfStockItems %></div>
                </div>
              </div>
            </div>
          </div>

          <div class="table-card shadow-sm">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th>#</th>
                    <th>Product Code</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Brand</th>
                    <th>Current Stock</th>
                    <th>Min Stock</th>
                    <th>Purchase Price</th>
                    <th>Selling Price</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (products && products.length) { %>
                    <% products.forEach((product, index) => { %>
                      <% const stockStatus = product.currentStock <= 0 ? 'Out of Stock' : product.currentStock <= product.minimumStock ? 'Low Stock' : 'Available'; %>
                      <% const statusClass = stockStatus === 'Out of Stock' ? 'bg-danger-subtle text-danger' : stockStatus === 'Low Stock' ? 'bg-warning-subtle text-warning' : 'bg-success-subtle text-success'; %>
                      <% const rowNumber = ((currentPage - 1) * 5) + index + 1; %>
                      <tr>
                        <td><%= rowNumber %></td>
                        <td><%= product.product_code || 'N/A' %></td>
                        <td class="fw-semibold"><%= product.name %></td>
                        <td><%= product.category || 'General' %></td>
                        <td><%= product.brand || '—' %></td>
                        <td><%= product.currentStock %></td>
                        <td><%= product.minimumStock %></td>
                        <td>Rs. <%= Number(product.purchasePrice).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                        <td>Rs. <%= Number(product.sellingPrice).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></td>
                        <td><span class="status-badge <%= statusClass %>"><%= stockStatus %></span></td>
                      </tr>
                    <% }); %>
                  <% } else { %>
                    <tr>
                      <td colspan="10" class="text-center text-muted py-4">No products are available in inventory.</td>
                    </tr>
                  <% } %>
                </tbody>
              </table>
            </div>

            <% if (totalPages > 1) { %>
              <div class="d-flex justify-content-between align-items-center px-3 py-3 border-top">
                <span class="text-muted small">Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong></span>
                <div class="btn-group" role="group" aria-label="Inventory pagination">
                  <a href="/employee/inventory?page=<%= Math.max(1, currentPage - 1) %>" class="btn btn-outline-secondary btn-sm <%= currentPage <= 1 ? 'disabled' : '' %>"><i class="bi bi-chevron-left"></i></a>
                  <a href="/employee/inventory?page=<%= Math.min(totalPages, currentPage + 1) %>" class="btn btn-outline-secondary btn-sm <%= currentPage >= totalPages ? 'disabled' : '' %>"><i class="bi bi-chevron-right"></i></a>
                </div>
              </div>
            <% } %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

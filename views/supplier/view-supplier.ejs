<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  </head>
  <body class="bg-light">
    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4" style="background: #ffffff; border-right: 1px solid #e7ebf0; min-height: 100vh; position: sticky; top: 0;">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Manager Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/manager/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
              <a class="nav-link px-3 py-2" href="/manager/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/manager/inventory"><i class="bi bi-stack me-2"></i>Inventory</a>
              <a class="nav-link px-3 py-2" href="/manager/purchases"><i class="bi bi-cart3 me-2"></i>Purchases</a>
              <a class="nav-link px-3 py-2" href="/manager/suppliers"><i class="bi bi-truck me-2"></i>Suppliers</a>
              <a class="nav-link px-3 py-2" href="/manager/tasks"><i class="bi bi-list-check me-2"></i>Assign Tasks</a>
              <a class="nav-link px-3 py-2" href="/manager/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/manager/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/manager/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 py-5 px-4">
          <div class="row justify-content-center">
            <div class="col-lg-8">
              <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                  <div class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h4 mb-0">Supplier Details</h1>
                    <div class="d-flex gap-2">
                      <a href="<%= basePath %>/suppliers/edit/<%= supplier.id %>" class="btn btn-warning btn-sm">Edit</a>
                      <a href="<%= listPath %>" class="btn btn-outline-secondary btn-sm">Back</a>
                  <div class="row g-3">
                    <div class="col-md-6"><strong>ID:</strong> <%= supplier.id %></div>
                    <div class="col-md-6"><strong>Supplier Code:</strong> <%= supplier.supplier_code %></div>
                    <div class="col-md-6"><strong>Supplier Name:</strong> <%= supplier.supplier_name %></div>
                    <div class="col-md-6"><strong>Contact Person:</strong> <%= supplier.contact_person %></div>
                    <div class="col-md-6"><strong>Phone:</strong> <%= supplier.phone %></div>
                    <div class="col-md-6"><strong>Email:</strong> <%= supplier.email || 'N/A' %></div>
                    <div class="col-md-6"><strong>GST Number:</strong> <%= supplier.gst_number || 'N/A' %></div>
                    <div class="col-md-6"><strong>Status:</strong> <span class="badge <%= statusClass %>"><%= supplier.status %></span></div>
                    <div class="col-md-6"><strong>City:</strong> <%= supplier.city || 'N/A' %></div>
                    <div class="col-md-6"><strong>State:</strong> <%= supplier.state || 'N/A' %></div>
                    <div class="col-md-6"><strong>Postal Code:</strong> <%= supplier.postal_code || 'N/A' %></div>
                    <div class="col-12"><strong>Address:</strong> <%= supplier.address || 'N/A' %></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

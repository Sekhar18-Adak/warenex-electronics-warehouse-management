<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body { background: #f5f7fb; color: #17324d; }
      .sidebar { background: #ffffff; border-right: 1px solid #e7ebf0; }
      .sidebar .nav-link { color: #4a5d72; border-radius: 10px; }
      .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: #eef4ff; color: #0d6efd; }
      .module-card { border: 1px solid #e7ebf0; border-radius: 16px; }
      .table-card { border-radius: 12px; }
      .status-badge { border-radius: 999px; }
    </style>
  </head>
  <body>
    <header class="navbar navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/manager/dashboard">Manager Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="text-muted small">Signed in as <strong><%= user?.name || 'Manager' %></strong></div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4" style="background: #ffffff; border-right: 1px solid #e7ebf0; min-height: calc(100vh - 76px); position: sticky; top: 76px; padding-bottom: 2rem;">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Manager Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/manager/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
              <a class="nav-link px-3 py-2" href="/manager/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/manager/inventory"><i class="bi bi-stack me-2"></i>Inventory</a>
              <a class="nav-link px-3 py-2" href="/manager/purchases"><i class="bi bi-cart3 me-2"></i>Purchases</a>
              <a class="nav-link px-3 py-2" href="/manager/suppliers"><i class="bi bi-truck me-2"></i>Suppliers</a>
              <a class="nav-link px-3 py-2" href="/manager/tasks"><i class="bi bi-list-check me-2"></i>Assign Tasks</a>
              <a class="nav-link px-3 py-2" href="/manager/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/manager/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/manager/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <% if (successMessage) { %>
            <div id="supplierSuccessAlert" class="alert alert-success alert-dismissible fade show" role="alert">
              <%= successMessage %>
            </div>
            <script>
              setTimeout(() => {
                const alert = document.getElementById('supplierSuccessAlert');
                if (alert) {
                  alert.classList.remove('show');
                  alert.classList.add('fade');
                  setTimeout(() => alert.remove(), 300);
                }
              }, 4000);
            </script>
          <% } %>

          <div class="d-flex justify-content-between align-items-center mb-3">
            <h1 class="h4 mb-0">Suppliers</h1>
            <a href="/manager/suppliers/add" class="btn btn-primary btn-sm">+ Add Supplier</a>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-4">
              <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                  <div class="text-primary fs-3 mb-2"><i class="bi bi-people"></i></div>
                  <div class="summary-label text-muted mb-2">Total Suppliers</div>
                  <div class="display-6 fw-semibold"><%= summary.total %></div>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-xl-4">
              <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                  <div class="text-success fs-3 mb-2"><i class="bi bi-check-circle"></i></div>
                  <div class="summary-label text-muted mb-2">Active Suppliers</div>
                  <div class="display-6 fw-semibold"><%= summary.active %></div>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-xl-4">
              <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                  <div class="text-secondary fs-3 mb-2"><i class="bi bi-slash-circle"></i></div>
                  <div class="summary-label text-muted mb-2">Inactive Suppliers</div>
                  <div class="display-6 fw-semibold"><%= summary.inactive %></div>
                </div>
              </div>
            </div>
          </div>

          <div class="card border-0 shadow-sm table-card">
            <div class="card-body p-3">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>ID</th>
                      <th>Supplier Name</th>
                      <th>Status</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!suppliers || !suppliers.length) { %>
                      <tr>
                        <td colspan="4" class="text-center text-muted py-4">No suppliers found.</td>
                      </tr>
                    <% } else { %>
                      <% suppliers.forEach((supplier) => { %>
                        <tr>
                          <td><%= supplier.id %></td>
                          <td><%= supplier.supplier_name %></td>
                          <td><span class="badge status-badge <%= supplier.statusClass %>"><%= supplier.status %></span></td>
                          <td>
                            <div class="d-flex gap-2 flex-wrap">
                              <a href="/manager/suppliers/view/<%= supplier.id %>" class="btn btn-outline-primary btn-sm">View Supplier</a>
                              <a href="/manager/suppliers/edit/<%= supplier.id %>" class="btn btn-outline-warning btn-sm">Edit Supplier</a>
                            </div>
                          </td>
                        </tr>
                      <% }); %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

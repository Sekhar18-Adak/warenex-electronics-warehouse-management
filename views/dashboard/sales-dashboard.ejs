<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
        padding-bottom: 2rem;
      }

      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .module-card {
        border: 1px solid #e7ebf0;
        border-radius: 16px;
        background: #fff;
      }

      .module-card:hover {
        border-color: #cfe0ff;
      }

      .summary-label {
        font-size: 0.86rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .chart-card {
        border-radius: 20px;
      }

      .dashboard-panel {
        animation: fadeUpIn 0.5s ease-out;
      }

      @keyframes fadeUpIn {
        from {
          opacity: 0;
          transform: translateY(10px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .range-toggle-group {
        background: #f3f6fb;
        border: 1px solid #dfe7f3;
        border-radius: 10px;
        padding: 4px;
      }

      .range-toggle {
        border: none;
        background: transparent;
        color: #4a5d72;
        font-size: 0.8rem;
        font-weight: 600;
        min-width: 78px;
        border-radius: 8px;
        transition: all 0.2s ease;
      }

      .range-toggle.active {
        background: #0d6efd;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(13, 110, 253, 0.18);
      }

      .donut-chart {
        width: 180px;
        height: 180px;
        border-radius: 50%;
        position: relative;
        background: conic-gradient(
          #2b7cff 0 45%,
          #28c76f 45% 75%,
          #f4b740 75% 90%,
          #a78bfa 90% 100%
        );
        box-shadow: inset 0 0 0 1px rgba(23, 50, 77, 0.05);
      }

      .donut-chart::before {
        content: "";
        position: absolute;
        inset: 25px;
        border-radius: 50%;
        background: #ffffff;
        box-shadow: inset 0 0 0 1px #e7ebf0;
      }

      .donut-center {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        text-align: center;
        z-index: 1;
      }

      .donut-center strong {
        display: block;
        font-size: 1.6rem;
        line-height: 1;
      }

      .legend-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 0.7rem 0;
        border-bottom: 1px solid #eef2f7;
      }

      .legend-item:last-child {
        border-bottom: 0;
      }

      .legend-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
      }

      .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        display: inline-block;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/sales/dashboard">Sales Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="d-flex align-items-center gap-2 text-muted small">
            <% if (user?.profile_image) { %>
              <img src="<%= user.profile_image %>" alt="Profile image" class="rounded-circle border" style="width: 28px; height: 28px; object-fit: cover;" />
            <% } else { %>
              <div class="rounded-circle border bg-light d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                <i class="bi bi-person-fill text-secondary"></i>
              </div>
            <% } %>
            <span>Signed in as <strong><%= user?.name || 'Sales Team' %></strong></span>
          </div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4 dashboard-panel">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Sales Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/sales/dashboard"><i class="bi bi-speedometer2 me-2"></i>Sales Management</a>
              <a class="nav-link px-3 py-2" href="/sales/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/sales/customers"><i class="bi bi-people me-2"></i>Customers</a>
              <a class="nav-link px-3 py-2" href="/sales/history"><i class="bi bi-clock-history me-2"></i>Sales History</a>
              <a class="nav-link px-3 py-2" href="/sales/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/sales/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/sales/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="row g-4">
            <div class="col-12">
              <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-start">
                    <div>
                      <h1 class="h3 fw-semibold mb-2">Sales Management</h1>
                      <p class="text-muted mb-0">Track daily performance, monitor orders, and review revenue across the sales cycle.</p>
                    </div>
                    <div class="border rounded-4 p-3 bg-light">
                      <div class="small text-uppercase text-muted">Welcome back</div>
                      <div class="fw-semibold fs-5 mt-1"><%= user?.name || 'Sales Team' %></div>
                      <div class="text-primary"><%= user?.role || 'Sales' %></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="row g-3">
                <% const metrics = [
                  ['Today\'s Sales', '$2,480', 'bi-currency-dollar', 'text-primary'],
                  ['Monthly Sales', '$18,400', 'bi-graph-up-arrow', 'text-success'],
                  ['Orders Today', '128', 'bi-cart3', 'text-warning'],
                  ['Pending Orders', '24', 'bi-hourglass-split', 'text-info'],
                  ['Completed Orders', '104', 'bi-check-circle', 'text-success'],
                  ['Revenue', '$15,650', 'bi-wallet2', 'text-primary']
                ]; %>

                <% metrics.forEach((metric) => { %>
                  <div class="col-sm-6 col-xl-4">
                    <div class="card module-card h-100 shadow-sm">
                      <div class="card-body">
                        <div class="<%= metric[3] %> fs-3 mb-2"><i class="bi <%= metric[2] %>"></i></div>
                        <div class="summary-label text-muted mb-2"><%= metric[0] %></div>
                        <div class="display-6 fw-semibold"><%= metric[1] %></div>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>


            <div class="col-12">
              <div class="row g-4">
                <div class="col-xl-8">
                  <div class="card border-0 shadow-sm h-100 chart-card dashboard-panel">
                    <div class="card-body p-4">
                      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
                        <h2 class="h5 mb-0">Sales Trend</h2>
                        <div class="btn-group range-toggle-group" role="group" aria-label="Sales period selector">
                          <button type="button" class="btn btn-sm range-toggle" data-range="today">Today</button>
                          <button type="button" class="btn btn-sm range-toggle active" data-range="monthly">Monthly</button>
                          <button type="button" class="btn btn-sm range-toggle" data-range="yearly">Yearly</button>
                        </div>
                      </div>

                      <svg viewBox="0 0 720 260" class="w-100" role="img" aria-label="Dummy sales graph">
                        <defs>
                          <linearGradient id="salesFill" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="#4f9cff" stop-opacity="0.35" />
                            <stop offset="100%" stop-color="#4f9cff" stop-opacity="0.04" />
                          </linearGradient>
                        </defs>
                        <g stroke="#dfe7f3" stroke-width="1">
                          <line x1="40" y1="30" x2="680" y2="30" />
                          <line x1="40" y1="80" x2="680" y2="80" />
                          <line x1="40" y1="130" x2="680" y2="130" />
                          <line x1="40" y1="180" x2="680" y2="180" />
                          <line x1="40" y1="230" x2="680" y2="230" />
                        </g>
                        <g fill="#6c7a89" font-size="11" font-family="Arial, sans-serif">
                          <text x="20" y="234">0</text>
                          <text x="8" y="184">4k</text>
                          <text x="8" y="134">8k</text>
                          <text x="2" y="84">12k</text>
                          <text x="2" y="34">16k</text>
                        </g>
                        <path d="M40,190 C120,170, 150,150, 210,160 S320,130, 380,110 S500,80, 560,95 S630,55, 680,70 L680,230 L40,230 Z" fill="url(#salesFill)" />
                        <path d="M40,190 C120,170, 150,150, 210,160 S320,130, 380,110 S500,80, 560,95 S630,55, 680,70" fill="none" stroke="#2b7cff" stroke-width="4" stroke-linecap="round" />
                        <g fill="#2b7cff">
                          <circle cx="210" cy="160" r="4" />
                          <circle cx="380" cy="110" r="4" />
                          <circle cx="560" cy="95" r="4" />
                          <circle cx="680" cy="70" r="5" />
                        </g>
                        <g fill="#6c7a89" font-size="11" font-family="Arial, sans-serif">
                          <text x="40" y="250">Mon</text>
                          <text x="160" y="250">Tue</text>
                          <text x="280" y="250">Wed</text>
                          <text x="400" y="250">Thu</text>
                          <text x="520" y="250">Fri</text>
                          <text x="640" y="250">Sat</text>
                        </g>
                      </svg>
                    </div>
                  </div>
                </div>

                <div class="col-xl-4">
                  <div class="card border-0 shadow-sm h-100 dashboard-panel">
                    <div class="card-body p-4">
                      <h2 class="h5 mb-3">Top Products</h2>

                      <div class="d-flex justify-content-center my-3">
                        <div class="donut-chart" aria-label="Top products pie chart">
                          <div class="donut-center">
                            <div>
                              <div class="small text-muted">Top</div>
                              <strong>45%</strong>
                            </div>
                          </div>
                        </div>
                      </div>

                      <div>
                        <div class="legend-item">
                          <div class="legend-label"><span class="legend-dot" style="background:#2b7cff;"></span> Smartphones</div>
                          <strong class="text-primary">45%</strong>
                        </div>
                        <div class="legend-item">
                          <div class="legend-label"><span class="legend-dot" style="background:#28c76f;"></span> Laptops</div>
                          <strong class="text-success">30%</strong>
                        </div>
                        <div class="legend-item">
                          <div class="legend-label"><span class="legend-dot" style="background:#f4b740;"></span> Accessories</div>
                          <strong class="text-warning">15%</strong>
                        </div>
                        <div class="legend-item">
                          <div class="legend-label"><span class="legend-dot" style="background:#a78bfa;"></span> Audio Gear</div>
                          <strong class="text-purple">10%</strong>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>

    <script>
      document.querySelectorAll('.range-toggle').forEach((button) => {
        button.addEventListener('click', () => {
          document.querySelectorAll('.range-toggle').forEach((btn) => btn.classList.remove('active'));
          button.classList.add('active');
        });
      });
    </script>
  </body>
</html>

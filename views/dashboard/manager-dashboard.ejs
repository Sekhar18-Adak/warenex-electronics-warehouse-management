<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
        padding-bottom: 2rem;
      }

      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .module-card {
        border: 1px solid #e7ebf0;
        border-radius: 16px;
        transition: none;
        min-height: 210px;
      }

      .module-card:hover {
        border-color: #cfe0ff;
      }

      .summary-label {
        font-size: 0.86rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .table-card {
        border-radius: 20px;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/manager/dashboard">Manager Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="d-flex align-items-center gap-2 text-muted small">
            <% if (user?.profile_image) { %>
              <img src="<%= user.profile_image %>" alt="Profile image" class="rounded-circle border" style="width: 28px; height: 28px; object-fit: cover;" />
            <% } else { %>
              <div class="rounded-circle border bg-light d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                <i class="bi bi-person-fill text-secondary"></i>
              </div>
            <% } %>
            <span>Signed in as <strong><%= user?.name || 'Manager' %></strong></span>
          </div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Manager Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/manager/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
              <a class="nav-link px-3 py-2" href="/manager/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/manager/inventory"><i class="bi bi-stack me-2"></i>Inventory</a>
              <a class="nav-link px-3 py-2" href="/manager/purchases"><i class="bi bi-cart3 me-2"></i>Purchases</a>
              <a class="nav-link px-3 py-2" href="/manager/suppliers"><i class="bi bi-truck me-2"></i>Suppliers</a>
              <a class="nav-link px-3 py-2" href="/manager/tasks"><i class="bi bi-list-check me-2"></i>Assign Tasks</a>
              <a class="nav-link px-3 py-2" href="/manager/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/manager/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/manager/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="row g-4">
            <div class="col-12">
              <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-start">
                    <div>
                      <h1 class="h3 fw-semibold mb-2">Manager Dashboard</h1>
                      <p class="text-muted mb-0">Monitor inventory health and open filtered product details without losing the fixed sidebar.</p>
                    </div>
                    <div class="border rounded-4 p-3 bg-light">
                      <div class="small text-uppercase text-muted">Welcome back</div>
                      <div class="fw-semibold fs-5 mt-1"><%= user?.name || 'Manager' %></div>
                      <div class="text-primary"><%= user?.role || 'Manager' %></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="row g-3">
                <div class="col-sm-6 col-xl-4">
                  <div class="card module-card h-100 shadow-sm">
                    <div class="card-body">
                      <div class="text-primary fs-3 mb-2"><i class="bi bi-box-seam"></i></div>
                      <div class="summary-label text-muted mb-2">Total Items</div>
                      <div class="display-6 fw-semibold"><%= summary.totalItems %></div>
                      <a href="/manager/products" class="btn btn-outline-primary btn-sm mt-3">View</a>
                    </div>
                  </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                  <div class="card module-card h-100 shadow-sm">
                    <div class="card-body">
                      <div class="text-warning fs-3 mb-2"><i class="bi bi-exclamation-triangle"></i></div>
                      <div class="summary-label text-muted mb-2">Low Stock Items</div>
                      <div class="display-6 fw-semibold"><%= summary.lowStockItems %></div>
                      <a href="/manager/products" class="btn btn-outline-primary btn-sm mt-3">View</a>
                    </div>
                  </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                  <div class="card module-card h-100 shadow-sm">
                    <div class="card-body">
                      <div class="text-danger fs-3 mb-2"><i class="bi bi-exclamation-octagon"></i></div>
                      <div class="summary-label text-muted mb-2">Out of Stock Items</div>
                      <div class="display-6 fw-semibold"><%= summary.outOfStockItems %></div>
                      <a href="/manager/products" class="btn btn-outline-primary btn-sm mt-3">View</a>
                    </div>
                  </div>
                </div>
                <div class="col-sm-6 col-xl-4">
                  <div class="card module-card h-100 shadow-sm">
                    <div class="card-body">
                      <div class="text-secondary fs-3 mb-2"><i class="bi bi-person-dash"></i></div>
                      <div class="summary-label text-muted mb-2">Inactive Employees</div>
                      <div class="display-6 fw-semibold"><%= inactiveEmployeeCount || 0 %></div>
                      <a href="/manager/tasks" class="btn btn-outline-primary btn-sm mt-3">Assign Tasks</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Product details moved to separate products page -->
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background-color: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
      }

      .navbar {
        position: sticky;
        top: 0;
        z-index: 1030;
      }

      .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .nav-link:hover {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .card {
        border-radius: 16px;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary d-flex align-items-center gap-2" href="/admin/dashboard">
          <img
            src="/image/ChatGPT%20Image%20Nov%201,%202026,%2004_15_44%20PM.png"
            alt="WareNex logo"
            width="34"
            height="34"
            class="rounded-circle border"
            style="object-fit: cover;"
          />
          <span>WareNex</span>
        </a>
        <div class="navbar-nav ms-auto gap-3 align-items-center">
          <div class="text-muted small">Logged in as <strong>Administrator</strong></div>
          <form action="/admin/logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-2 sidebar p-3">
          <h6 class="text-uppercase small text-muted px-2 mb-3">Main Navigation</h6>
          <nav class="nav flex-column gap-1">
            <a class="nav-link px-3 py-2" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
            <a class="nav-link px-3 py-2" href="/admin/employee"><i class="bi bi-people me-2"></i>Employees</a>
            <a class="nav-link px-3 py-2" href="/admin/inventory"><i class="bi bi-stack me-2"></i>Inventory</a>
            <a class="nav-link px-3 py-2" href="/admin/tasks"><i class="bi bi-list-check me-2"></i>Tasks</a>
            <a class="nav-link px-3 py-2" href="/admin/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
            <a class="nav-link px-3 py-2" href="/admin/suppliers"><i class="bi bi-truck me-2"></i>Suppliers</a>
            <a class="nav-link px-3 py-2" href="/admin/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
          </nav>
        </aside>

        <main class="col-lg-10 p-4 p-xl-5">
          <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3 mb-4">
            <div>
              <h1 class="h3 fw-semibold mb-2">Announcements & Tasks</h1>
              <p class="text-muted mb-0">Assign tasks to managers, sales staff, or employees and send them through the notification system.</p>
            </div>
            <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
          </div>

          <% if (successMessage) { %>
            <div class="alert alert-success auto-dismiss-alert" role="alert"><i class="bi bi-check-circle-fill me-2"></i><%= successMessage %></div>
          <% } %>

          <% if (errorMessage) { %>
            <div class="alert alert-danger auto-dismiss-alert" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMessage %></div>
          <% } %>

          <div class="row g-4">
            <div class="col-lg-5">
              <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                  <h4 class="fw-semibold mb-3">Assign Task</h4>
                  <form action="/admin/announcements/task" method="post">
                    <div class="mb-3">
                      <label class="form-label">Receiver ID / Name</label>
                      <input
                        type="text"
                        id="receiverSearch"
                        list="receiverOptions"
                        class="form-control"
                        placeholder="Search by ID or name"
                        autocomplete="off"
                        required
                      />
                      <datalist id="receiverOptions">
                        <% if (recipients && recipients.length) { %>
                          <% recipients.forEach((recipient) => { %>
                            <option value="<%= recipient.id %> - <%= recipient.name %> (<%= recipient.role %>)" data-id="<%= recipient.id %>"></option>
                          <% }); %>
                        <% } %>
                      </datalist>
                      <input type="hidden" id="receiver_id" name="receiver_id" value="" />
                    </div>

                    <div class="mb-3">
                      <label class="form-label">Task Title</label>
                      <input type="text" name="title" class="form-control" placeholder="Enter task title" required />
                    </div>

                    <div class="mb-3">
                      <label class="form-label">Task Details</label>
                      <textarea name="message" class="form-control" rows="5" placeholder="Describe the task or task instructions" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Send Task</button>
                  </form>
                </div>
              </div>
            </div>

            <div class="col-lg-7">
              <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                  <h4 class="fw-semibold mb-3">Recent Assignments</h4>

                  <% if (!tasks || !tasks.length) { %>
                    <div class="text-muted text-center py-4">No task assignments yet.</div>
                  <% } else { %>
                    <div class="table-responsive">
                      <table class="table align-middle mb-0">
                        <thead>
                          <tr>
                            <th>Role</th>
                            <th>Title</th>
                            <th>Message</th>
                            <th>Date</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% tasks.forEach((task) => { %>
                            <tr>
                              <td><span class="badge bg-light text-dark"><%= task.type %></span></td>
                              <td class="fw-semibold"><%= task.title %></td>
                              <td><%= task.message %></td>
                              <td class="text-muted small">
                                <div><%= new Date(task.createdAt).toLocaleString() %></div>
                                <form action="/admin/announcements/delete/<%= task.id %>" method="post" class="mt-2" onsubmit="return confirm('Delete this task assignment?');">
                                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                              </td>
                            </tr>
                          <% }); %>
                        </tbody>
                      </table>
                    </div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
    <script>
      const receiverSearchInput = document.getElementById('receiverSearch');
      const receiverIdInput = document.getElementById('receiver_id');

      if (receiverSearchInput && receiverIdInput) {
        receiverSearchInput.addEventListener('change', () => {
          const selectedValue = receiverSearchInput.value;
          const matchedOption = Array.from(document.querySelectorAll('#receiverOptions option')).find((option) => option.value === selectedValue);
          const selectedReceiverId = matchedOption ? matchedOption.dataset.id : '';
          receiverIdInput.value = selectedReceiverId;
        });
      }

      setTimeout(() => {
        document.querySelectorAll('.auto-dismiss-alert').forEach((alertElement) => {
          alertElement.remove();
        });
      }, 5000);
    </script>
  </body>
</html>

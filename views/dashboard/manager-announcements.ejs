<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }
      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
      }
      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }
      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }
      .announcement-card {
        border: 1px solid #e7ebf0;
        border-radius: 16px;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/manager/dashboard">Manager Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="text-muted small">Signed in as <strong><%= user?.name || 'Manager' %></strong></div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Manager Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/manager/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
              <a class="nav-link px-3 py-2" href="/manager/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/manager/inventory"><i class="bi bi-stack me-2"></i>Inventory</a>
              <a class="nav-link px-3 py-2" href="/manager/purchases"><i class="bi bi-cart3 me-2"></i>Purchases</a>
              <a class="nav-link px-3 py-2" href="/manager/suppliers"><i class="bi bi-truck me-2"></i>Suppliers</a>
              <a class="nav-link px-3 py-2" href="/manager/tasks"><i class="bi bi-list-check me-2"></i>Assign Tasks</a>
              <a class="nav-link px-3 py-2" href="/manager/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/manager/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/manager/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
              <h1 class="h3 fw-semibold mb-1">Announcements</h1>
              <p class="text-muted mb-0">Messages from admin staff and inventory alerts.</p>
            </div>
          </div>

          <% if (!announcements || !announcements.length) { %>
            <div class="card announcement-card shadow-sm border-0">
              <div class="card-body p-4 text-center text-muted">
                No announcements available right now.
              </div>
            </div>
          <% } else { %>
            <div class="list-group gap-3">
              <% announcements.forEach((item) => { %>
                <div class="list-group-item border-0 announcement-card shadow-sm">
                  <div class="d-flex justify-content-between align-items-start gap-3 p-3">
                    <div>
                      <div class="fw-semibold mb-1"><%= item.title %></div>
                      <div class="text-muted"><%= item.message %></div>
                    </div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                      <small class="text-muted text-nowrap"><%= new Date(item.created_at).toLocaleString() %></small>
                      <span class="badge <%= item.is_read ? 'bg-success-subtle text-success-emphasis' : 'bg-primary-subtle text-primary-emphasis' %>">
                        <%= item.is_read ? 'Read' : 'Unread' %>
                      </span>
                      <form action="/manager/announcements/<%= item.id %>/done" method="POST" class="mb-0">
                        <button type="submit" class="btn btn-sm btn-success">Done</button>
                      </form>
                    </div>
                  </div>
                  <div class="px-3 pb-3">
                    <a href="/manager/announcements/<%= item.id %>" class="text-decoration-none">View details</a>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } %>
        </main>
      </div>
    </div>
  </body>
</html>

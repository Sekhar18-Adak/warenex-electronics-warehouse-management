<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
        padding-bottom: 2rem;
      }

      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .module-card {
        border: 1px solid #e7ebf0;
        border-radius: 16px;
        transition: none;
        min-height: 210px;
      }

      .module-card:hover {
        border-color: #cfe0ff;
      }

      .summary-label {
        font-size: 0.86rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/employee/dashboard">Employee Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="d-flex align-items-center gap-2 text-muted small">
            <% if (user?.profile_image) { %>
              <img src="<%= user.profile_image %>" alt="Profile image" class="rounded-circle border" style="width: 28px; height: 28px; object-fit: cover;" />
            <% } else { %>
              <div class="rounded-circle border bg-light d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                <i class="bi bi-person-fill text-secondary"></i>
              </div>
            <% } %>
            <span>Signed in as <strong><%= user?.name || 'Employee' %></strong></span>
          </div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Employee Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/employee/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
              <a class="nav-link px-3 py-2" href="/employee/inventory"><i class="bi bi-box-seam me-2"></i>Inventory View</a>
              <a class="nav-link px-3 py-2" href="/employee/tasks"><i class="bi bi-list-check me-2"></i>Assigned Tasks</a>
              <a class="nav-link px-3 py-2" href="/employee/profile"><i class="bi bi-person-circle me-2"></i>My Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="row g-4">
            <div class="col-12">
              <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                  <div class="d-flex flex-column flex-md-row justify-content-between gap-3 align-items-start">
                    <div>
                      <h1 class="h3 fw-semibold mb-2">Employee Dashboard</h1>
                      <p class="text-muted mb-0">Stay focused on your assigned work while moving through the store efficiently.</p>
                    </div>
                    <div class="border rounded-4 p-3 bg-light">
                      <div class="small text-uppercase text-muted">Welcome back</div>
                      <div class="fw-semibold fs-5 mt-1"><%= user?.name || 'Employee' %></div>
                      <div class="text-primary"><%= user?.role || 'Employee' %></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-12">
              <div class="row g-3">
                <% const cards = [
                  { label: 'Total Tasks Completed', value: summary.completedTasks || 0, icon: 'bi-check-circle', tone: 'success', accent: 'bg-success-subtle text-success' },
                  { label: 'In Progress Tasks', value: summary.inProgressTasks || 0, icon: 'bi-hourglass-split', tone: 'primary', accent: 'bg-primary-subtle text-primary' },
                  { label: 'Remaining Tasks', value: summary.remainingTasks || 0, icon: 'bi-list-task', tone: 'warning', accent: 'bg-warning-subtle text-warning' },
                  { label: 'High Priority Tasks', value: summary.highPriorityTasks || 0, icon: 'bi-exclamation-triangle', tone: 'danger', accent: 'bg-danger-subtle text-danger' },
                  { label: 'Medium Priority Tasks', value: summary.mediumPriorityTasks || 0, icon: 'bi-circle-half', tone: 'info', accent: 'bg-info-subtle text-info' },
                  { label: 'Low Priority Tasks', value: summary.lowPriorityTasks || 0, icon: 'bi-dash-circle', tone: 'secondary', accent: 'bg-secondary-subtle text-secondary' }
                ]; %>

                <% cards.forEach((card) => { %>
                  <div class="col-sm-6 col-xl-4">
                    <div class="card h-100 shadow-sm border-0">
                      <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                          <span class="summary-label text-muted"><%= card.label %></span>
                          <span class="rounded-circle <%= card.accent %> d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                            <i class="bi <%= card.icon %> fs-5"></i>
                          </span>
                        </div>
                        <div class="display-6 fw-semibold mb-0"><%= card.value %></div>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background-color: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
      }

      .navbar {
        position: sticky;
        top: 0;
        z-index: 1030;
      }

      .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .nav-link:hover,
      .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .summary-card {
        border: 1px solid #e7ebf0;
        border-radius: 16px;
        background: #fff;
      }

      .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 0.42rem 0.7rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/manager/dashboard">Manager Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="d-flex align-items-center gap-2 text-muted small">
            <% if (user?.profile_image) { %>
              <img src="<%= user.profile_image %>" alt="Profile image" class="rounded-circle border" style="width: 28px; height: 28px; object-fit: cover;" />
            <% } else { %>
              <div class="rounded-circle border bg-light d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                <i class="bi bi-person-fill text-secondary"></i>
              </div>
            <% } %>
            <span>Signed in as <strong><%= user?.name || 'Manager' %></strong></span>
          </div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Manager Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/manager/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
              <a class="nav-link px-3 py-2" href="/manager/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/manager/inventory"><i class="bi bi-stack me-2"></i>Inventory</a>
              <a class="nav-link px-3 py-2" href="/manager/purchases"><i class="bi bi-cart3 me-2"></i>Purchases</a>
              <a class="nav-link px-3 py-2" href="/manager/suppliers"><i class="bi bi-truck me-2"></i>Suppliers</a>
              <a class="nav-link px-3 py-2 active" href="/manager/tasks"><i class="bi bi-list-check me-2"></i>Assign Tasks</a>
              <a class="nav-link px-3 py-2" href="/manager/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/manager/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/manager/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4 p-xl-5">
          <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3 mb-4">
            <div>
              <h1 class="h3 fw-semibold mb-2">Assign Tasks</h1>
              <p class="text-muted mb-0">View inactive employees and assign a task directly to the task table in the database.</p>
            </div>
            <a href="/manager/dashboard" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
          </div>

          <% if (successMessage) { %>
            <div class="alert alert-success" role="alert"><i class="bi bi-check-circle-fill me-2"></i><%= successMessage %></div>
          <% } %>

          <% if (errorMessage) { %>
            <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= errorMessage %></div>
          <% } %>

          <div class="row g-4 mb-4">
            <div class="col-md-6 col-xl-3">
              <div class="summary-card p-4 h-100">
                <div class="text-muted small text-uppercase">Inactive Employees</div>
                <div class="display-6 fw-semibold mt-2"><%= inactiveEmployeeCount || 0 %></div>
              </div>
            </div>
            <div class="col-md-6 col-xl-3">
              <div class="summary-card p-4 h-100">
                <div class="text-muted small text-uppercase">Task Queue</div>
                <div class="display-6 fw-semibold mt-2 text-primary">Ready</div>
              </div>
            </div>
          </div>

          <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
              <% if (!inactiveEmployees || !inactiveEmployees.length) { %>
                <div class="text-center text-muted py-5">
                  <i class="bi bi-people fs-1 d-block mb-3"></i>
                  No inactive employees are available for assignment right now.
                </div>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table align-middle mb-0">
                    <thead>
                      <tr>
                        <th>Employee ID</th>
                        <th>Name</th>
                        <th>Status</th>
                        <th class="text-end">Action</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% inactiveEmployees.forEach((employee) => { %>
                        <tr>
                          <td class="fw-semibold">#<%= employee.id %></td>
                          <td><%= employee.name %></td>
                          <td>
                            <span class="status-badge bg-warning-subtle text-warning">
                              <%= employee.status || 'Inactive' %>
                            </span>
                          </td>
                          <td class="text-end">
                            <button
                              type="button"
                              class="btn btn-primary btn-sm assign-task-btn"
                              data-employee-id="<%= employee.id %>"
                              data-employee-name="<%= employee.name %>"
                              data-bs-toggle="modal"
                              data-bs-target="#assignTaskModal"
                            >
                              Assign Task
                            </button>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </main>
      </div>
    </div>

    <div class="modal fade" id="assignTaskModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Assign Task</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <form action="/manager/tasks/assign" method="post">
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">Employee</label>
                <div id="employeeNameLabel" class="form-control-plaintext fw-semibold text-primary">Employee</div>
                <input type="hidden" name="assigned_to" id="assignedToInput" required />
              </div>

              <div class="mb-3">
                <label for="taskTitle" class="form-label">Task Title</label>
                <input id="taskTitle" name="title" type="text" class="form-control" placeholder="Enter task title" required />
              </div>

              <div class="mb-3">
                <label for="taskDescription" class="form-label">Description</label>
                <textarea id="taskDescription" name="description" class="form-control" rows="4" placeholder="Describe the task details" required></textarea>
              </div>

              <div class="row g-3">
                <div class="col-md-6">
                  <label for="taskPriority" class="form-label">Priority</label>
                  <select id="taskPriority" name="priority" class="form-select">
                    <option value="Low">Low</option>
                    <option value="Medium" selected>Medium</option>
                    <option value="High">High</option>
                    <option value="Urgent">Urgent</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="taskDueDate" class="form-label">Due Date</label>
                  <input id="taskDueDate" name="due_date" type="date" class="form-control" required />
                </div>
              </div>

              <div class="mt-3">
                <label for="taskNotes" class="form-label">Additional Notes</label>
                <textarea id="taskNotes" name="additional_notes" class="form-control" rows="3" placeholder="Optional notes"></textarea>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
              <button type="submit" class="btn btn-primary">Save Task</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      const assignTaskButtons = document.querySelectorAll('.assign-task-btn');
      const employeeNameLabel = document.getElementById('employeeNameLabel');
      const assignedToInput = document.getElementById('assignedToInput');
      const taskDueDate = document.getElementById('taskDueDate');

      if (taskDueDate) {
        const today = new Date();
        const formattedToday = new Date(today.getTime() - (today.getTimezoneOffset() * 60000)).toISOString().slice(0, 10);
        taskDueDate.min = formattedToday;
      }

      assignTaskButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const employeeId = button.dataset.employeeId;
          const employeeName = button.dataset.employeeName;

          assignedToInput.value = employeeId;
          employeeNameLabel.textContent = `${employeeName} (#${employeeId})`;
        });
      });
    </script>
  </body>
</html>

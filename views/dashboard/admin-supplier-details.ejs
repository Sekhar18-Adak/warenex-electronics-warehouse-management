<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background-color: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
      }

      .navbar {
        position: sticky;
        top: 0;
        z-index: 1030;
      }

      .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .nav-link:hover {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .detail-card {
        border: 1px solid #e7ebf0;
        border-radius: 16px;
        background: #fff;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary d-flex align-items-center gap-2" href="/admin/dashboard">
          <img
            src="/image/ChatGPT%20Image%20Nov%201,%202026,%2004_15_44%20PM.png"
            alt="WareNex logo"
            width="34"
            height="34"
            class="rounded-circle border"
            style="object-fit: cover;"
          />
          <span>WareNex</span>
        </a>
        <div class="navbar-nav ms-auto gap-3 align-items-center">
          <div class="text-muted small">Logged in as <strong>Administrator</strong></div>
          <form action="/admin/logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-2 sidebar p-3">
          <h6 class="text-uppercase small text-muted px-2 mb-3">Main Navigation</h6>
          <nav class="nav flex-column gap-1">
            <a class="nav-link px-3 py-2" href="/admin/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
            <a class="nav-link px-3 py-2" href="/admin/employee"><i class="bi bi-people me-2"></i>Employees</a>
            <a class="nav-link px-3 py-2" href="/admin/inventory"><i class="bi bi-stack me-2"></i>Inventory</a>
            <a class="nav-link px-3 py-2" href="/admin/tasks"><i class="bi bi-list-check me-2"></i>Tasks</a>
            <a class="nav-link px-3 py-2" href="/admin/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
            <a class="nav-link px-3 py-2" href="/admin/suppliers"><i class="bi bi-truck me-2"></i>Suppliers</a>
            <a class="nav-link px-3 py-2" href="/admin/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
          </nav>
        </aside>

        <main class="col-lg-10 p-4 p-xl-5">
          <div class="d-flex flex-column flex-lg-row justify-content-between align-items-start gap-3 mb-4">
            <div>
              <h1 class="h3 fw-semibold mb-2">Supplier Details</h1>
              <p class="text-muted mb-0">Full supplier profile information.</p>
            </div>
            <a href="/admin/suppliers" class="btn btn-outline-secondary btn-sm">Back to Suppliers</a>
          </div>

          <div class="detail-card p-4">
            <div class="row g-4">
              <div class="col-md-6">
                <div class="mb-3">
                  <div class="text-muted small text-uppercase">Supplier ID</div>
                  <div class="fw-semibold"><%= supplier.id %></div>
                </div>
                <div class="mb-3">
                  <div class="text-muted small text-uppercase">Supplier Code</div>
                  <div class="fw-semibold"><%= supplier.supplier_code %></div>
                </div>
                <div class="mb-3">
                  <div class="text-muted small text-uppercase">Supplier Name</div>
                  <div class="fw-semibold"><%= supplier.supplier_name %></div>
                </div>
                <div class="mb-3">
                  <div class="text-muted small text-uppercase">Contact Person</div>
                  <div class="fw-semibold"><%= supplier.contact_person %></div>
                </div>
              </div>

              <div class="col-md-6">
                <div class="mb-3">
                  <div class="text-muted small text-uppercase">Phone</div>
                  <div class="fw-semibold"><%= supplier.phone %></div>
                </div>
                <div class="mb-3">
                  <div class="text-muted small text-uppercase">Email</div>
                  <div class="fw-semibold"><%= supplier.email || "N/A" %></div>
                </div>
                <div class="mb-3">
                  <div class="text-muted small text-uppercase">GST Number</div>
                  <div class="fw-semibold"><%= supplier.gst_number || "N/A" %></div>
                </div>
                <div class="mb-3">
                  <div class="text-muted small text-uppercase">Status</div>
                  <span class="badge <%= supplier.statusClass %>"><%= supplier.status %></span>
                </div>
              </div>
            </div>

            <div class="row g-4 mt-1">
              <div class="col-md-4">
                <div class="text-muted small text-uppercase">City</div>
                <div class="fw-semibold"><%= supplier.city || "N/A" %></div>
              </div>
              <div class="col-md-4">
                <div class="text-muted small text-uppercase">State</div>
                <div class="fw-semibold"><%= supplier.state || "N/A" %></div>
              </div>
              <div class="col-md-4">
                <div class="text-muted small text-uppercase">Postal Code</div>
                <div class="fw-semibold"><%= supplier.postal_code || "N/A" %></div>
              </div>
            </div>

            <div class="mt-4">
              <div class="text-muted small text-uppercase mb-2">Address</div>
              <div class="border rounded p-3 bg-light"><%= supplier.address || "N/A" %></div>
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

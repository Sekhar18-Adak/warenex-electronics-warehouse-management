<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body { background: #f5f7fb; color: #17324d; }
      .sidebar { background: #ffffff; border-right: 1px solid #e7ebf0; }
      .sidebar .nav-link { color: #4a5d72; border-radius: 10px; }
      .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: #eef4ff; color: #0d6efd; }
      .card-box { border: 1px solid #e7ebf0; border-radius: 18px; }
      .status-badge { border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; padding: 0.45rem 0.7rem; font-size: 0.76rem; font-weight: 600; }
      .info-label { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: #6c7a89; }
    </style>
  </head>
  <body>
    <header class="navbar navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/manager/dashboard">Manager Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="text-muted small">Signed in as <strong><%= user?.name || 'Manager' %></strong></div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4" style="background: #ffffff; border-right: 1px solid #e7ebf0; min-height: calc(100vh - 76px); position: sticky; top: 76px; padding-bottom: 2rem;">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Manager Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/manager/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
              <a class="nav-link px-3 py-2" href="/manager/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/manager/inventory"><i class="bi bi-stack me-2"></i>Inventory</a>
              <a class="nav-link px-3 py-2" href="/manager/purchases"><i class="bi bi-cart3 me-2"></i>Purchases</a>
              <a class="nav-link px-3 py-2" href="/manager/suppliers"><i class="bi bi-truck me-2"></i>Suppliers</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
              <h1 class="h3 mb-1">Purchase Details</h1>
              <p class="text-muted mb-0">Order <strong><%= purchase.poNo %></strong></p>
            </div>
            <a href="/manager/purchases" class="btn btn-outline-secondary">
              <i class="bi bi-arrow-left me-2"></i>Back to Purchase Orders
            </a>
          </div>

          <div class="row g-4">
            <div class="col-lg-4">
              <div class="card card-box shadow-sm h-100">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">Order Summary</h2>
                    <span class="status-badge <%= statusClass %>"><%= purchase.status %></span>
                  </div>

                  <div class="mb-3">
                    <div class="info-label">Purchase Order No</div>
                    <div class="fw-semibold fs-5"><%= purchase.poNo %></div>
                  </div>

                  <div class="mb-3">
                    <div class="info-label">Supplier</div>
                    <div class="fw-semibold"><%= purchase.supplier %></div>
                  </div>

                  <div class="mb-3">
                    <div class="info-label">Order Date</div>
                    <div><%= purchase.orderDate %></div>
                  </div>

                  <div class="mb-3">
                    <div class="info-label">Expected Delivery</div>
                    <div><%= purchase.expectedDelivery %></div>
                  </div>

                  <div class="mb-3">
                    <div class="info-label">Actual Delivery</div>
                    <div><%= purchase.actualDelivery || 'Not delivered yet' %></div>
                  </div>

                  <div class="mb-3">
                    <div class="info-label">Payment Status</div>
                    <div><%= purchase.paymentStatus %></div>
                  </div>

                  <div class="mb-3">
                    <div class="info-label">Total Amount</div>
                    <div class="fw-bold text-primary fs-5"><%= purchase.formattedTotal %></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-lg-8">
              <div class="card card-box shadow-sm mb-4">
                <div class="card-body">
                  <h2 class="h5 mb-3">Supplier Information</h2>
                  <div class="row g-3">
                    <div class="col-md-6">
                      <div class="info-label">Contact Person</div>
                      <div><%= purchase.supplierContact || 'N/A' %></div>
                    </div>
                    <div class="col-md-6">
                      <div class="info-label">Phone</div>
                      <div><%= purchase.supplierPhone || 'N/A' %></div>
                    </div>
                    <div class="col-md-6">
                      <div class="info-label">Email</div>
                      <div><%= purchase.supplierEmail || 'N/A' %></div>
                    </div>
                    <div class="col-md-6">
                      <div class="info-label">Created By</div>
                      <div><%= purchase.createdByName || 'N/A' %></div>
                    </div>
                    <div class="col-md-12">
                      <div class="info-label">Notes</div>
                      <div><%= purchase.notes || 'No notes provided.' %></div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="card card-box shadow-sm">
                <div class="card-body">
                  <h2 class="h5 mb-3">Products in this order</h2>
                  <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                      <thead class="table-light">
                        <tr>
                          <th>Product</th>
                          <th>Code</th>
                          <th>Category</th>
                          <th>Qty</th>
                          <th>Unit Price</th>
                          <th>Subtotal</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% if (!purchase.items || !purchase.items.length) { %>
                          <tr>
                            <td colspan="6" class="text-center text-muted py-4">No product items found for this purchase order.</td>
                          </tr>
                        <% } else { %>
                          <% purchase.items.forEach((item) => { %>
                            <tr>
                              <td>
                                <div class="fw-semibold"><%= item.productName %></div>
                                <div class="small text-muted"><%= item.brand || 'Brand not available' %> / <%= item.model || 'Model not available' %></div>
                              </td>
                              <td><%= item.productCode %></td>
                              <td><%= item.category || 'N/A' %></td>
                              <td><%= item.quantity %></td>
                              <td>Rs. <%= item.formattedPurchasePrice %></td>
                              <td>Rs. <%= item.formattedSubtotal %></td>
                            </tr>
                          <% }); %>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
      }

      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .module-card {
        border: 1px solid #e7ebf0;
        border-radius: 16px;
      }

      .table-card {
        border-radius: 12px;
      }

      .status-badge {
        border-radius: 999px;
        font-size: 0.76rem;
        padding: 0.42rem 0.7rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
      }

      .dropdown-menu {
        min-width: 220px;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/manager/dashboard">Manager Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="text-muted small">Signed in as <strong><%= user?.name || 'Manager' %></strong></div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4" style="background: #ffffff; border-right: 1px solid #e7ebf0; min-height: calc(100vh - 76px); position: sticky; top: 76px; padding-bottom: 2rem;">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Manager Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/manager/dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
              <a class="nav-link px-3 py-2" href="/manager/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/manager/inventory"><i class="bi bi-stack me-2"></i>Inventory</a>
              <a class="nav-link px-3 py-2" href="/manager/purchases"><i class="bi bi-cart3 me-2"></i>Purchases</a>
              <a class="nav-link px-3 py-2" href="/manager/suppliers"><i class="bi bi-truck me-2"></i>Suppliers</a>
              <a class="nav-link px-3 py-2" href="/manager/tasks"><i class="bi bi-list-check me-2"></i>Assign Tasks</a>
              <a class="nav-link px-3 py-2" href="/manager/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/manager/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/manager/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
              <h1 class="h3 mb-1">Purchase Orders</h1>
              <p class="text-muted mb-0">Track supplier orders and order progress.</p>
            </div>
            <button class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Create Purchase</button>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-2">
              <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                  <div class="text-secondary fs-4 mb-2"><i class="bi bi-bag-check"></i></div>
                  <div class="text-muted small mb-1">Total Orders</div>
                  <div class="display-6 fw-semibold"><%= summary.total %></div>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-xl-2">
              <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                  <div class="text-success fs-4 mb-2"><i class="bi bi-check-circle"></i></div>
                  <div class="text-muted small mb-1">Approved</div>
                  <div class="display-6 fw-semibold"><%= summary.approved %></div>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-xl-2">
              <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                  <div class="text-danger fs-4 mb-2"><i class="bi bi-x-circle"></i></div>
                  <div class="text-muted small mb-1">Cancelled</div>
                  <div class="display-6 fw-semibold"><%= summary.cancelled %></div>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-xl-2">
              <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                  <div class="text-warning fs-4 mb-2"><i class="bi bi-hourglass-split"></i></div>
                  <div class="text-muted small mb-1">Pending</div>
                  <div class="display-6 fw-semibold"><%= summary.pending %></div>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-xl-2">
              <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                  <div class="text-primary fs-4 mb-2"><i class="bi bi-clipboard-check"></i></div>
                  <div class="text-muted small mb-1">Completed</div>
                  <div class="display-6 fw-semibold"><%= summary.completed %></div>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-xl-2">
              <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                  <div class="text-info fs-4 mb-2"><i class="bi bi-slack"></i></div>
                  <div class="text-muted small mb-1">Partially Approved</div>
                  <div class="display-6 fw-semibold"><%= summary.partiallyApproved %></div>
                </div>
              </div>
            </div>
          </div>

          <div class="card border-0 shadow-sm table-card">
            <div class="card-body p-3">
              <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-3">
                <div>
                  <h2 class="h5 mb-1"><%= activeLabel %></h2>
                  <p class="text-muted mb-0">Showing <strong><%= purchases.length %></strong> order<%= purchases.length === 1 ? '' : 's' %>.</p>
                </div>

                <div class="dropdown">
                  <button class="btn btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-funnel me-2"></i>Filter
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                    <li><a class="dropdown-item <%= activeFilter === 'all' ? 'active' : '' %>" href="/manager/purchases?filter=all&page=1">All Orders</a></li>
                    <li><a class="dropdown-item <%= activeFilter === 'approved' ? 'active' : '' %>" href="/manager/purchases?filter=approved&page=1">Approved</a></li>
                    <li><a class="dropdown-item <%= activeFilter === 'pending' ? 'active' : '' %>" href="/manager/purchases?filter=pending&page=1">Pending</a></li>
                    <li><a class="dropdown-item <%= activeFilter === 'cancelled' ? 'active' : '' %>" href="/manager/purchases?filter=cancelled&page=1">Cancelled</a></li>
                    <li><a class="dropdown-item <%= activeFilter === 'completed' ? 'active' : '' %>" href="/manager/purchases?filter=completed&page=1">Completed</a></li>
                    <li><a class="dropdown-item <%= activeFilter === 'partially approved' ? 'active' : '' %>" href="/manager/purchases?filter=partially-approved&page=1">Partially Approved</a></li>
                  </ul>
                </div>
              </div>

              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>PO No</th>
                      <th>Supplier</th>
                      <th>Order Date</th>
                      <th>Expected Delivery</th>
                      <th>Status</th>
                      <th>Total Amount</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!purchases || !purchases.length) { %>
                      <tr>
                        <td colspan="7" class="text-center text-muted py-4">No purchase orders found for this filter.</td>
                      </tr>
                    <% } else { %>
                      <% purchases.forEach((purchase) => { %>
                        <tr>
                          <td class="fw-semibold text-primary"><%= purchase.poNo %></td>
                          <td><%= purchase.supplier %></td>
                          <td><%= purchase.orderDate %></td>
                          <td><%= purchase.expectedDelivery %></td>
                          <td>
                            <span class="status-badge <%= purchase.statusClass %>"><%= purchase.status %></span>
                          </td>
                          <td class="fw-semibold"><%= purchase.formattedTotal %></td>
                          <td>
                            <div class="d-flex gap-2">
                              <a href="/manager/purchases/view/<%= purchase.id %>" class="btn btn-sm btn-outline-primary">View</a>
                              <% if (purchase.status !== 'Completed') { %>
                                <a href="/manager/purchases/edit/<%= purchase.id %>" class="btn btn-sm btn-outline-secondary">Edit</a>
                              <% } %>
                            </div>
                          </td>
                        </tr>
                      <% }); %>
                    <% } %>
                  </tbody>
                </table>
              </div>

              <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <span class="text-muted small">Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong></span>
                  <div class="btn-group" role="group" aria-label="Purchase pagination">
                    <a href="/manager/purchases?filter=<%= activeFilter %>&page=<%= Math.max(1, currentPage - 1) %>" class="btn btn-outline-secondary btn-sm <%= currentPage <= 1 ? 'disabled' : '' %>">
                      <i class="bi bi-chevron-left"></i>
                    </a>
                    <a href="/manager/purchases?filter=<%= activeFilter %>&page=<%= Math.min(totalPages, currentPage + 1) %>" class="btn btn-outline-secondary btn-sm <%= currentPage >= totalPages ? 'disabled' : '' %>">
                      <i class="bi bi-chevron-right"></i>
                    </a>
                  </div>
                </div>
              <% } %>
            </div>
          </div>
        </main>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>

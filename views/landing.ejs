<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <meta
      name="description"
      content="Professional internal landing page for the Electronics Warehouse Management System."
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/landing.css" />
  </head>
  <body>
    <header class="navbar navbar-expand-lg border-bottom bg-white sticky-top">
      <div class="container py-2">
        <a class="navbar-brand fw-semibold text-primary d-flex align-items-center gap-2" href="/">
          <img
            src="/image/ChatGPT%20Image%20Nov%201,%202026,%2004_15_44%20PM.png"
            alt="WareNex logo"
            width="36"
            height="36"
            class="rounded-circle border"
            style="object-fit: cover;"
          />
          <span>WareNex</span>
        </a>
        <div class="navbar-nav ms-auto gap-3 align-items-center">
          <a class="nav-link text-dark" href="#features">Features</a>
          <a class="nav-link text-dark" href="#modules">Modules</a>
          <a class="nav-link text-dark" href="#about">About</a>
          <a class="btn btn-outline-primary btn-sm" href="/login">Login</a>
        </div>
      </div>
    </header>

    <main>
      <section class="hero-section py-5 py-lg-6">
        <div class="container">
          <div class="row align-items-center g-5">
            <div class="col-lg-7">
              <span class="badge rounded-pill bg-light text-primary border mb-3 px-3 py-2">
                Internal Enterprise Platform
              </span>
              <h1 class="display-5 fw-semibold mb-3">
                WareNex – Electronics Warehouse Management System
              </h1>
              <p class="lead text-muted mb-4">
                A secure and efficient platform for managing electronics inventory,
                employee operations, purchases, sales, and warehouse workflows.
              </p>
              <div class="d-flex flex-wrap gap-3">
                <a class="btn btn-primary px-4" href="/login">Employee Login</a>
                <a class="btn btn-outline-secondary px-4" href="#features">View Features</a>
              </div>
              <div class="mt-4 text-muted small">
                Built for internal store operations, stock visibility, and controlled access.
              </div>
            </div>
            <div class="col-lg-5">
              <div class="card shadow-sm border-0 p-3 p-lg-4 hero-panel">
                <svg viewBox="0 0 520 360" class="w-100" role="img" aria-label="Warehouse management illustration">
                  <rect x="40" y="60" width="440" height="250" rx="16" fill="#f5f8ff"></rect>
                  <rect x="72" y="92" width="120" height="150" rx="8" fill="#ffffff" stroke="#d7e2f4" stroke-width="2"></rect>
                  <rect x="210" y="92" width="120" height="150" rx="8" fill="#ffffff" stroke="#d7e2f4" stroke-width="2"></rect>
                  <rect x="348" y="92" width="100" height="150" rx="8" fill="#ffffff" stroke="#d7e2f4" stroke-width="2"></rect>
                  <rect x="90" y="110" width="84" height="8" rx="4" fill="#1453d2"></rect>
                  <rect x="90" y="132" width="84" height="8" rx="4" fill="#94b7ff"></rect>
                  <rect x="90" y="154" width="84" height="8" rx="4" fill="#1453d2"></rect>
                  <rect x="228" y="110" width="84" height="8" rx="4" fill="#1453d2"></rect>
                  <rect x="228" y="132" width="84" height="8" rx="4" fill="#94b7ff"></rect>
                  <rect x="228" y="154" width="84" height="8" rx="4" fill="#1453d2"></rect>
                  <rect x="366" y="110" width="64" height="8" rx="4" fill="#1453d2"></rect>
                  <rect x="366" y="132" width="64" height="8" rx="4" fill="#94b7ff"></rect>
                  <rect x="366" y="154" width="64" height="8" rx="4" fill="#1453d2"></rect>
                  <rect x="80" y="252" width="150" height="18" rx="9" fill="#dfe8f7"></rect>
                  <rect x="255" y="252" width="140" height="18" rx="9" fill="#dfe8f7"></rect>
                  <circle cx="382" cy="260" r="32" fill="#1453d2"></circle>
                  <path d="M370 260h24" stroke="#ffffff" stroke-width="6" stroke-linecap="round"></path>
                  <path d="M382 248v24" stroke="#ffffff" stroke-width="6" stroke-linecap="round"></path>
                  <path d="M108 290h300" stroke="#cbd7eb" stroke-width="3" stroke-linecap="round"></path>
                </svg>
                <div class="row g-3 mt-3">
                  <div class="col-6">
                    <div class="border rounded p-3 bg-light-subtle">
                      <div class="fw-semibold">Live stock visibility</div>
                      <div class="small text-muted">Inventory status across warehouse zones</div>
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="border rounded p-3 bg-light-subtle">
                      <div class="fw-semibold">Controlled workflows</div>
                      <div class="small text-muted">Purchases, sales, and employee operations</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="features" class="section-block bg-light">
        <div class="container">
          <div class="section-heading text-center mb-5">
            <span class="text-uppercase small text-primary fw-semibold">Core capabilities</span>
            <h2 class="h2 fw-semibold mt-2">Operational features for daily warehouse control</h2>
            <p class="text-muted mx-auto mt-3" style="max-width: 700px;">
              Designed to support stock accuracy, employee accountability, and fast transaction handling across the electronics store environment.
            </p>
          </div>
          <div class="row g-4">
            <% const features = [
              {title: 'Employee Authentication', text: 'Secure internal sign-in and session handling for staff access.'},
              {title: 'Role Based Access Control', text: 'Restrict modules and actions by employee role and clearance level.'},
              {title: 'Inventory Management', text: 'Track products, stock levels, storage zones, and movement history.'},
              {title: 'Purchase Management', text: 'Record supplier orders, approvals, and receiving workflows.'},
              {title: 'Sales Management', text: 'Process sales transactions and maintain accurate item movement.'},
              {title: 'Supplier Management', text: 'Manage vendor records, delivery details, and supply coordination.'},
              {title: 'Real-Time Stock Tracking', text: 'Monitor stock status and location updates across the warehouse.'},
              {title: 'Reporting & Analytics', text: 'Review inventory trends, employee performance, and operational insight.'}
            ]; %>
            <% features.forEach((feature, index) => { %>
              <div class="col-md-6 col-lg-3">
                <div class="card h-100 border-0 shadow-sm">
                  <div class="card-body">
                    <div class="feature-icon mb-3"><%= index + 1 %></div>
                    <h3 class="h6 fw-semibold"><%= feature.title %></h3>
                    <p class="text-muted small mb-0"><%= feature.text %></p>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

      <section id="modules" class="section-block">
        <div class="container">
          <div class="section-heading text-center mb-5">
            <span class="text-uppercase small text-primary fw-semibold">System modules</span>
            <h2 class="h2 fw-semibold mt-2">A complete internal operations framework</h2>
          </div>
          <div class="row g-4">
            <% const modules = ['Authentication', 'Employee Management', 'Product Management', 'Inventory Management', 'Purchase Orders', 'Sales Orders', 'Suppliers', 'Reports', 'Dashboard Analytics']; %>
            <% modules.forEach((module) => { %>
              <div class="col-sm-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 module-card">
                  <div class="card-body d-flex align-items-center justify-content-between">
                    <span class="fw-semibold"><%= module %></span>
                    <span class="text-primary">→</span>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

      <section id="about" class="section-block bg-light">
        <div class="container">
          <div class="row g-5 align-items-start">
            <div class="col-lg-6">
              <span class="text-uppercase small text-primary fw-semibold">Why adopt this system</span>
              <h2 class="h2 fw-semibold mt-2">Reliable operational control for store and warehouse teams</h2>
              <p class="text-muted mt-3">
                The platform consolidates inventory movement, employee activity, transaction records, and warehouse oversight into a single internal environment.
              </p>
            </div>
            <div class="col-lg-6">
              <div class="row g-3">
                <% const benefits = ['Centralized inventory control', 'Reduced stock errors', 'Improved operational efficiency', 'Better employee management', 'Faster sales processing', 'Secure role-based access', 'Complete transaction history', 'Business performance insights']; %>
                <% benefits.forEach((benefit) => { %>
                  <div class="col-sm-6">
                    <div class="card border-0 shadow-sm h-100">
                      <div class="card-body">
                        <div class="d-flex align-items-center gap-2">
                          <span class="checkmark">✓</span>
                          <span class="fw-medium"><%= benefit %></span>
                        </div>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section-block">
        <div class="container">
          <div class="section-heading text-center mb-5">
            <span class="text-uppercase small text-primary fw-semibold">Security foundation</span>
            <h2 class="h2 fw-semibold mt-2">Protected internal access and auditable workflows</h2>
          </div>
          <div class="row g-4">
            <% const securityItems = ['JWT Authentication', 'Password Encryption (bcrypt)', 'Role-Based Access Control', 'Session Management', 'Audit Logging']; %>
            <% securityItems.forEach((securityItem) => { %>
              <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                  <div class="card-body">
                    <h3 class="h6 fw-semibold"><%= securityItem %></h3>
                    <p class="text-muted small mb-0">Supports secure employee access and controlled operational visibility.</p>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

    </main>

    <footer class="py-4 border-top bg-white">
      <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <div>
          <div class="fw-semibold">WareNex – Electronics Warehouse Management System</div>
          <div class="small text-muted">Version 1.0 · Internal Enterprise Application</div>
        </div>
        <div class="small text-muted">© 2026 Electronics Store Operations</div>
      </div>
    </footer>
  </body>
</html>

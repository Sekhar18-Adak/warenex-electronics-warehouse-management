<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body { background: #f5f7fb; color: #17324d; }
      .form-card { border-radius: 12px; }
    </style>
  </head>
  <body>
    <header class="navbar navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/manager/dashboard">Manager Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="text-muted small">Signed in as <strong><%= user?.name || 'Manager' %></strong></div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container py-4">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card form-card shadow-sm">
            <div class="card-body p-4">
              <h3 class="mb-3">Add Product</h3>

              <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger"><%= error %></div>
              <% } %>

              <form action="/manager/products/add" method="post">
                <div class="row g-3">
                  <div class="col-md-6">
                    <label class="form-label">Product Name</label>
                    <input name="name" value="<%= form?.name || '' %>" required class="form-control" />
                  </div>

                  <div class="col-md-6">
                    <label class="form-label">Category</label>
                    <input name="category" value="<%= form?.category || '' %>" class="form-control" />
                  </div>

                  <div class="col-md-6">
                    <label class="form-label">Brand</label>
                    <input name="brand" value="<%= form?.brand || '' %>" class="form-control" />
                  </div>

                  <div class="col-md-6">
                    <label class="form-label">Model</label>
                    <input name="model" value="<%= form?.model || '' %>" class="form-control" />
                  </div>

                  <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea name="description" rows="3" class="form-control"><%= form?.description || '' %></textarea>
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">Purchase Price</label>
                    <input name="purchase_price" type="number" step="0.01" value="<%= form?.purchase_price || '' %>" required class="form-control" />
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">Selling Price</label>
                    <input name="selling_price" type="number" step="0.01" value="<%= form?.selling_price || '' %>" required class="form-control" />
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">Unit</label>
                    <input name="unit" value="<%= form?.unit || 'Piece' %>" class="form-control" />
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">Current Stock</label>
                    <input name="current_stock" type="number" value="<%= form?.current_stock || 0 %>" class="form-control" />
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">Minimum Stock</label>
                    <input name="minimum_stock" type="number" value="<%= form?.minimum_stock || 5 %>" class="form-control" />
                  </div>

                  <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                      <option value="Active" <%= (form?.status || 'Active') === 'Active' ? 'selected' : '' %>>Active</option>
                      <option value="Inactive" <%= (form?.status || '') === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                      <option value="Discontinued" <%= (form?.status || '') === 'Discontinued' ? 'selected' : '' %>>Discontinued</option>
                    </select>
                  </div>

                  <div class="col-12 text-end mt-3">
                    <a href="/manager/products" class="btn btn-secondary me-2">Cancel</a>
                    <button class="btn btn-primary">Save Product</button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

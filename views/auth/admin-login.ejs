<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/css/auth.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
  </head>
  <body>
    <div class="auth-layout">
      <div class="auth-panel auth-panel-left d-flex flex-column justify-content-between text-white p-4 p-lg-5">
        <div>
          <div class="auth-brand mb-4 d-flex align-items-center gap-3">
            <img
              src="/image/ChatGPT%20Image%20Nov%201,%202026,%2004_15_44%20PM.png"
              alt="WareNex logo"
              width="52"
              height="52"
              class="rounded-circle border border-light-subtle"
              style="object-fit: cover; background: rgba(255,255,255,0.08);"
            />
            <div>
              <span class="d-block text-uppercase fw-bold">WareNex</span>
              <span class="h4 fw-semibold">Electronics Warehouse Management System</span>
            </div>
          </div>

          <div class="mb-4">
            <span class="badge bg-white text-primary mb-3">Internal Enterprise Portal</span>
            <p class="mb-4 text-muted-light">
              This platform provides secure employee authentication and centralized warehouse operations management for electronics inventory, purchasing, sales, and business workflows.
            </p>
          </div>

          <div class="row g-3 overview-cards">
            <div class="col-6">
              <div class="card card-sm bg-white bg-opacity-15 border-0 p-3">
                <div class="fw-semibold">Employee Authentication</div>
              </div>
            </div>
            <div class="col-6">
              <div class="card card-sm bg-white bg-opacity-15 border-0 p-3">
                <div class="fw-semibold">Inventory Management</div>
              </div>
            </div>
            <div class="col-6">
              <div class="card card-sm bg-white bg-opacity-15 border-0 p-3">
                <div class="fw-semibold">Purchase Management</div>
              </div>
            </div>
            <div class="col-6">
              <div class="card card-sm bg-white bg-opacity-15 border-0 p-3">
                <div class="fw-semibold">Sales Operations</div>
              </div>
            </div>
          </div>
        </div>

        <div class="security-badges mt-4">
          <div class="badge-row">
            <span>✓ Secure Login</span>
            <span>✓ Role-Based Access</span>
          </div>
          <div class="badge-row mt-2">
            <span>✓ JWT Authentication</span>
            <span>✓ Session Management</span>
          </div>
        </div>
      </div>

      <div class="auth-panel auth-panel-right d-flex align-items-center justify-content-center p-4 p-lg-5">
        <div class="login-card w-100">
          <div class="text-center mb-4">
            <h2 class="fw-semibold mb-1">Admin Login</h2>
            <p class="text-muted mb-0">Authorized personnel access only</p>
          </div>

          <% if (authError) { %>
            <div class="alert alert-danger" role="alert"><%= authError %></div>
          <% } %>

          <form action="/admin/login" method="POST" novalidate>
            <div class="mb-3">
              <label for="email" class="form-label fw-semibold">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-control"
                placeholder="admin@warehouse.local"
                value="<%= email %>"
                required
              />
            </div>

            <div class="mb-3">
              <label for="password" class="form-label fw-semibold">Password</label>
              <div class="input-group">
                <input
                  type="password"
                  id="password"
                  name="password"
                  class="form-control"
                  placeholder="Enter password"
                  required
                />
                <button type="button" class="btn btn-outline-secondary" id="togglePassword" aria-label="Show password">
                  <i class="bi bi-eye"></i>
                </button>
              </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="remember" name="remember" />
                <label class="form-check-label text-muted" for="remember">Remember Me</label>
              </div>
              
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100">Sign In</button>
          </form>

          <p class="mt-4 mb-0 text-muted small">
            Access to this system is restricted to authorized employees only. All login activities are monitored and recorded.
          </p>
          <p class="mt-3 mb-0 text-center">
            <a href="/" class="text-decoration-none">Back to landing page</a>
          </p>
        </div>
      </div>
    </div>

    <footer class="auth-footer text-center text-muted small py-3">
      <div>WareNex – Electronics Warehouse Management System</div>
      <div>Version 1.0 · Internal Enterprise Application</div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      const togglePasswordBtn = document.getElementById('togglePassword');
      const adminPasswordInput = document.getElementById('password');
      if (togglePasswordBtn && adminPasswordInput) {
        togglePasswordBtn.addEventListener('click', () => {
          const isHidden = adminPasswordInput.type === 'password';
          adminPasswordInput.type = isHidden ? 'text' : 'password';
          togglePasswordBtn.innerHTML = isHidden ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
          togglePasswordBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
        });
      }
    </script>
  </body>
</html>

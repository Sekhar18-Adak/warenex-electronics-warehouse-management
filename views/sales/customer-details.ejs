<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }

      .card {
        border-radius: 16px;
      }
    </style>
  </head>
  <body>
    <div class="container py-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 fw-semibold mb-1">Customer Details</h1>
          <p class="text-muted mb-0">Profile information and payment summary.</p>
        </div>
        <div class="d-flex gap-2">
          <a href="/sales/customers" class="btn btn-outline-secondary">Back to Customers</a>
          <a href="/sales/dashboard" class="btn btn-primary">Dashboard</a>
        </div>
      </div>

      <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
          <div class="row g-4">
            <div class="col-md-6">
              <div class="text-uppercase text-muted small mb-2">Customer Code</div>
              <div class="fw-semibold fs-5"><%= customer.customer_code %></div>
            </div>
            <div class="col-md-6">
              <div class="text-uppercase text-muted small mb-2">Customer Name</div>
              <div class="fw-semibold fs-5"><%= customer.customer_name %></div>
            </div>
            <div class="col-md-6">
              <div class="text-uppercase text-muted small mb-2">Phone</div>
              <div><%= customer.phone || 'Not provided' %></div>
            </div>
            <div class="col-md-6">
              <div class="text-uppercase text-muted small mb-2">Email</div>
              <div><%= customer.email || 'Not provided' %></div>
            </div>
            <div class="col-md-6">
              <div class="text-uppercase text-muted small mb-2">City</div>
              <div><%= customer.city || 'Not provided' %></div>
            </div>
            <div class="col-md-6">
              <div class="text-uppercase text-muted small mb-2">State</div>
              <div><%= customer.state || 'Not provided' %></div>
            </div>
            <div class="col-12">
              <div class="text-uppercase text-muted small mb-2">Address</div>
              <div><%= customer.address || 'Not provided' %></div>
            </div>
            <div class="col-md-6">
              <div class="text-uppercase text-muted small mb-2">Postal Code</div>
              <div><%= customer.postal_code || 'Not provided' %></div>
            </div>
            <div class="col-md-6">
              <div class="text-uppercase text-muted small mb-2">Total Payment</div>
              <div class="fw-bold text-success fs-5"><%= customer.total_payment_formatted %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

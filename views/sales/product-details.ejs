<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }

      .card {
        border-radius: 16px;
      }
    </style>
  </head>
  <body>
    <div class="container py-5">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 fw-semibold mb-1">Product Details</h1>
          <p class="text-muted mb-0"><%= product.name %></p>
        </div>
        <a href="/sales/products" class="btn btn-outline-primary btn-sm">Back to Products</a>
      </div>

      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Product ID</div>
              <div class="fw-semibold"><%= product.id %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Product Code</div>
              <div class="fw-semibold"><%= product.product_code %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Name</div>
              <div class="fw-semibold"><%= product.name %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Category</div>
              <div class="fw-semibold"><%= product.category %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Brand</div>
              <div class="fw-semibold"><%= product.brand %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Model</div>
              <div class="fw-semibold"><%= product.model %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Buying Price</div>
              <div class="fw-semibold"><%= product.purchase_price_formatted %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Selling Price</div>
              <div class="fw-semibold"><%= product.selling_price_formatted %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Current Stock</div>
              <div class="fw-semibold"><%= product.current_stock %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Minimum Stock</div>
              <div class="fw-semibold"><%= product.minimum_stock %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Unit</div>
              <div class="fw-semibold"><%= product.unit %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Status</div>
              <div class="fw-semibold"><%= product.status %></div>
            </div>
            <div class="col-12">
              <div class="small text-uppercase text-muted">Description</div>
              <div class="fw-semibold"><%= product.description %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Created At</div>
              <div class="fw-semibold"><%= product.created_at ? new Date(product.created_at).toLocaleString() : 'N/A' %></div>
            </div>
            <div class="col-md-6">
              <div class="small text-uppercase text-muted">Updated At</div>
              <div class="fw-semibold"><%= product.updated_at ? new Date(product.updated_at).toLocaleString() : 'N/A' %></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>

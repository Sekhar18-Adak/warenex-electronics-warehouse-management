<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
        padding-bottom: 2rem;
      }

      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .module-card {
        border: 1px solid #e7ebf0;
        border-radius: 16px;
        background: #fff;
      }

      .table-card {
        border-radius: 16px;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/sales/dashboard">Sales Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="text-muted small">Signed in as <strong><%= user?.name || 'Sales Team' %></strong></div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Sales Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/sales/dashboard"><i class="bi bi-speedometer2 me-2"></i>Sales Management</a>
              <a class="nav-link px-3 py-2" href="/sales/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/sales/customers"><i class="bi bi-people me-2"></i>Customers</a>
              <a class="nav-link px-3 py-2" href="/sales/history"><i class="bi bi-clock-history me-2"></i>Sales History</a>
              <a class="nav-link px-3 py-2" href="/sales/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/sales/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/sales/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
              <h1 class="h3 fw-semibold mb-1">Customer List</h1>
              <p class="text-muted mb-0">All registered customers and their payment totals.</p>
            </div>
            <div class="d-flex gap-2 align-items-center">
              <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#addCustomerModal">
                <i class="bi bi-plus-circle me-1"></i>Add Customer
              </button>
              <a href="/sales/dashboard" class="btn btn-outline-primary btn-sm">Back to Dashboard</a>
            </div>
          </div>

          <% if (typeof successMessage !== 'undefined' && successMessage) { %>
            <div class="alert alert-success"><%= successMessage %></div>
          <% } %>

          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert alert-danger"><%= errorMessage %></div>
          <% } %>

          <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-4">
              <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                  <div class="text-primary fs-3 mb-2"><i class="bi bi-people"></i></div>
                  <div class="text-uppercase text-muted small mb-2">Total Customers</div>
                  <div class="display-6 fw-semibold"><%= summary?.total ?? 0 %></div>
                </div>
              </div>
            </div>
            <div class="col-sm-6 col-xl-8">
              <div class="card module-card h-100 shadow-sm">
                <div class="card-body">
                  <div class="text-success fs-3 mb-2"><i class="bi bi-currency-dollar"></i></div>
                  <div class="text-uppercase text-muted small mb-2">Total Payment</div>
                  <div class="display-6 fw-semibold"><%= formatCurrencyAmount(summary?.totalPayment ?? 0) %></div>
                </div>
              </div>
            </div>
          </div>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <div class="card border-0 shadow-sm table-card">
            <div class="card-body p-3">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Customer Code</th>
                      <th>Name</th>
                      <th>Total Payment</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!customers || !customers.length) { %>
                      <tr>
                        <td colspan="4" class="text-center text-muted py-4">No customers found.</td>
                      </tr>
                    <% } else { %>
                      <% customers.forEach((customer) => { %>
                        <tr>
                          <td><%= customer.customer_code %></td>
                          <td><%= customer.customer_name %></td>
                          <td><%= customer.total_payment_formatted %></td>
                          <td>
                            <div class="d-flex gap-2 flex-wrap">
                              <a href="/sales/customers/view/<%= customer.id %>" class="btn btn-outline-primary btn-sm">View Details</a>
                              <button
                                type="button"
                                class="btn btn-outline-warning btn-sm edit-customer-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#editCustomerModal"
                                data-id="<%= customer.id %>"
                                data-code="<%= customer.customer_code %>"
                                data-name="<%= customer.customer_name %>"
                                data-phone="<%= customer.phone %>"
                                data-email="<%= customer.email %>"
                                data-address="<%= customer.address %>"
                                data-city="<%= customer.city %>"
                                data-state="<%= customer.state %>"
                                data-postal="<%= customer.postal_code %>"
                                data-total-payment="<%= Number(customer.total_payment_till_now ?? 0) %>">
                                Edit
                              </button>
                            </div>
                          </td>
                        </tr>
                      <% }); %>
                    <% } %>
                  </tbody>
                </table>
              </div>

              <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mt-3 pt-3 border-top">
                <div class="text-muted small">Page <%= pagination?.page ?? 1 %> of <%= pagination?.totalPages ?? 1 %></div>

                <div class="d-flex gap-2">
                  <% if (pagination?.hasPrev) { %>
                    <a href="/sales/customers?page=<%= pagination.page - 1 %>" class="btn btn-outline-primary btn-sm">
                      <i class="bi bi-arrow-left"></i> Previous
                    </a>
                  <% } else { %>
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled>
                      <i class="bi bi-arrow-left"></i> Previous
                    </button>
                  <% } %>

                  <% if (pagination?.hasNext) { %>
                    <a href="/sales/customers?page=<%= pagination.page + 1 %>" class="btn btn-primary btn-sm">
                      Next <i class="bi bi-arrow-right"></i>
                    </a>
                  <% } else { %>
                    <button type="button" class="btn btn-secondary btn-sm" disabled>
                      Next <i class="bi bi-arrow-right"></i>
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          </div>

          <div class="modal fade" id="addCustomerModal" tabindex="-1" aria-labelledby="addCustomerModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="addCustomerModalLabel">Add New Customer</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/sales/customers/add" method="post">
                  <div class="modal-body row g-3">
                    <div class="col-md-6">
                      <label for="customerCode" class="form-label">Customer Code</label>
                      <input type="text" class="form-control" id="customerCode" name="customer_code" value="<%= nextCustomerCode || '' %>" readonly required />
                    </div>
                    <div class="col-md-6">
                      <label for="customerName" class="form-label">Customer Name</label>
                      <input type="text" class="form-control" id="customerName" name="customer_name" required />
                    </div>
                    <div class="col-md-6">
                      <label for="customerPhone" class="form-label">Phone</label>
                      <input type="text" class="form-control" id="customerPhone" name="phone" required />
                    </div>
                    <div class="col-md-6">
                      <label for="customerTotalPayment" class="form-label">Total Payment Till Now</label>
                      <input type="number" class="form-control" id="customerTotalPayment" name="total_payment_till_now" step="0.01" min="0" value="0" />
                    </div>
                    <div class="col-md-6">
                      <label for="customerEmail" class="form-label">Email</label>
                      <input type="email" class="form-control" id="customerEmail" name="email" />
                    </div>
                    <div class="col-12">
                      <label for="customerAddress" class="form-label">Address</label>
                      <textarea class="form-control" id="customerAddress" name="address" rows="3"></textarea>
                    </div>
                    <div class="col-md-4">
                      <label for="customerCity" class="form-label">City</label>
                      <input type="text" class="form-control" id="customerCity" name="city" />
                    </div>
                    <div class="col-md-4">
                      <label for="customerState" class="form-label">State</label>
                      <input type="text" class="form-control" id="customerState" name="state" />
                    </div>
                    <div class="col-md-4">
                      <label for="customerPostal" class="form-label">Postal Code</label>
                      <input type="text" class="form-control" id="customerPostal" name="postal_code" />
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Customer</button>
                  </div>
                </form>
              </div>
            </div>
          </div>

          <div class="modal fade" id="editCustomerModal" tabindex="-1" aria-labelledby="editCustomerModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title" id="editCustomerModalLabel">Update Customer Details</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form id="editCustomerForm" method="post">
                  <div class="modal-body row g-3">
                    <div class="col-md-6">
                      <label for="editCustomerCode" class="form-label">Customer Code</label>
                      <input type="text" class="form-control" id="editCustomerCode" name="customer_code" required />
                    </div>
                    <div class="col-md-6">
                      <label for="editCustomerName" class="form-label">Customer Name</label>
                      <input type="text" class="form-control" id="editCustomerName" name="customer_name" required />
                    </div>
                    <div class="col-md-6">
                      <label for="editCustomerPhone" class="form-label">Phone</label>
                      <input type="text" class="form-control" id="editCustomerPhone" name="phone" required />
                    </div>
                    <div class="col-md-6">
                      <label for="editCustomerTotalPayment" class="form-label">Total Payment Till Now</label>
                      <input type="number" class="form-control" id="editCustomerTotalPayment" name="total_payment_till_now" step="0.01" min="0" value="0" />
                    </div>
                    <div class="col-md-6">
                      <label for="editCustomerEmail" class="form-label">Email</label>
                      <input type="email" class="form-control" id="editCustomerEmail" name="email" />
                    </div>
                    <div class="col-12">
                      <label for="editCustomerAddress" class="form-label">Address</label>
                      <textarea class="form-control" id="editCustomerAddress" name="address" rows="3"></textarea>
                    </div>
                    <div class="col-md-4">
                      <label for="editCustomerCity" class="form-label">City</label>
                      <input type="text" class="form-control" id="editCustomerCity" name="city" />
                    </div>
                    <div class="col-md-4">
                      <label for="editCustomerState" class="form-label">State</label>
                      <input type="text" class="form-control" id="editCustomerState" name="state" />
                    </div>
                    <div class="col-md-4">
                      <label for="editCustomerPostal" class="form-label">Postal Code</label>
                      <input type="text" class="form-control" id="editCustomerPostal" name="postal_code" />
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Update Customer</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const editCustomerForm = document.getElementById('editCustomerForm');

        document.querySelectorAll('.edit-customer-btn').forEach((button) => {
          button.addEventListener('click', () => {
            const id = button.dataset.id;
            const code = button.dataset.code || '';
            const name = button.dataset.name || '';
            const phone = button.dataset.phone || '';
            const email = button.dataset.email || '';
            const address = button.dataset.address || '';
            const city = button.dataset.city || '';
            const state = button.dataset.state || '';
            const postal = button.dataset.postal || '';
            const totalPayment = button.dataset.totalPayment || '0';

            editCustomerForm.action = `/sales/customers/${id}/update`;
            document.getElementById('editCustomerCode').value = code;
            document.getElementById('editCustomerName').value = name;
            document.getElementById('editCustomerPhone').value = phone;
            document.getElementById('editCustomerTotalPayment').value = totalPayment;
            document.getElementById('editCustomerEmail').value = email;
            document.getElementById('editCustomerAddress').value = address;
            document.getElementById('editCustomerCity').value = city;
            document.getElementById('editCustomerState').value = state;
            document.getElementById('editCustomerPostal').value = postal;
          });
        });
      });
    </script>
  </body>
</html>

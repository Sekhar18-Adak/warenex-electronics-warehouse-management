<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }
      .report-card {
        background: #fff;
        border: 1px solid #e7ebf0;
        border-radius: 18px;
      }
      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
        padding-bottom: 2rem;
      }
      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }
      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/sales/dashboard">Sales Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="d-flex align-items-center gap-2 text-muted small">
            <% if (user?.profile_image) { %>
              <img src="<%= user.profile_image %>" alt="Profile image" class="rounded-circle border" style="width: 28px; height: 28px; object-fit: cover;" />
            <% } else { %>
              <div class="rounded-circle border bg-light d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                <i class="bi bi-person-fill text-secondary"></i>
              </div>
            <% } %>
            <span>Signed in as <strong><%= user?.name || 'Sales Team' %></strong></span>
          </div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Sales Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/sales/dashboard"><i class="bi bi-speedometer2 me-2"></i>Sales Management</a>
              <a class="nav-link px-3 py-2" href="/sales/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/sales/customers"><i class="bi bi-people me-2"></i>Customers</a>
              <a class="nav-link px-3 py-2" href="/sales/history"><i class="bi bi-clock-history me-2"></i>Sales History</a>
              <a class="nav-link px-3 py-2" href="/sales/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/sales/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/sales/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="report-card p-4 shadow-sm">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start mb-4 gap-2">
              <div>
                <div class="small text-uppercase text-muted">Sales Report</div>
                <h1 class="h3 fw-bold mb-0">Submit a Report</h1>
              </div>
            </div>

            <% if (successMessage) { %>
              <div class="alert alert-success auto-dismiss-alert" role="alert"><%= successMessage %></div>
            <% } %>
            <% if (errorMessage) { %>
              <div class="alert alert-danger auto-dismiss-alert" role="alert"><%= errorMessage %></div>
            <% } %>

            <form action="/sales/reports" method="post" enctype="multipart/form-data">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label fw-semibold" for="title">Report Title</label>
                  <input id="title" name="title" type="text" class="form-control" required placeholder="Enter report title" />
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold" for="reportType">Report Type</label>
                  <select id="reportType" name="reportType" class="form-select" required>
                    <option value="">Select report type</option>
                    <% reportTypes.forEach((type) => { %>
                      <option value="<%= type %>"><%= type %></option>
                    <% }); %>
                  </select>
                </div>

                <div class="col-md-6">
                  <label class="form-label fw-semibold" for="priority">Priority</label>
                  <select id="priority" name="priority" class="form-select" required>
                    <% priorities.forEach((priority) => { %>
                      <option value="<%= priority %>" <%= priority === 'Medium' ? 'selected' : '' %>><%= priority %></option>
                    <% }); %>
                  </select>
                </div>

                <div class="col-12">
                  <label class="form-label fw-semibold" for="description">Description</label>
                  <textarea id="description" name="description" rows="6" class="form-control" required placeholder="Enter the complete details of the issue or report"></textarea>
                </div>

                <div class="col-12">
                  <label class="form-label fw-semibold" for="attachment">Attachment</label>
                  <input id="attachment" name="attachment" type="file" class="form-control" accept=".jpg,.jpeg,.png,.pdf" />
                  <div class="form-text">Allowed: JPG, JPEG, PNG, PDF. Maximum size: 5 MB.</div>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                  <a href="/sales/dashboard" class="btn btn-outline-secondary">Cancel</a>
                  <button type="submit" class="btn btn-primary">Submit Report</button>
                </div>
              </div>
            </form>
          </div>
        </main>
      </div>
    </div>
    <script>
      setTimeout(() => {
        document.querySelectorAll('.auto-dismiss-alert').forEach((alertElement) => {
          alertElement.remove();
        });
      }, 4000);
    </script>
  </body>
</html>

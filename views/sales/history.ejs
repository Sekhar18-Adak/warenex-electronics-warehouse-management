<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
        padding-bottom: 2rem;
      }

      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .table-card {
        border-radius: 16px;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/sales/dashboard">Sales Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="text-muted small">Signed in as <strong><%= user?.name || 'Sales Team' %></strong></div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Sales Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/sales/dashboard"><i class="bi bi-speedometer2 me-2"></i>Sales Management</a>
              <a class="nav-link px-3 py-2" href="/sales/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/sales/customers"><i class="bi bi-people me-2"></i>Customers</a>
              <a class="nav-link px-3 py-2" href="/sales/history"><i class="bi bi-clock-history me-2"></i>Sales History</a>
              <a class="nav-link px-3 py-2" href="/sales/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/sales/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/sales/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
              <h1 class="h3 fw-semibold mb-1">Sales History</h1>
              <p class="text-muted mb-0">Recent sales records and date-based filtering.</p>
            </div>
            <a href="/sales/dashboard" class="btn btn-outline-primary btn-sm">Back to Dashboard</a>
          </div>

          <div class="card border-0 shadow-sm mb-4 table-card">
            <div class="card-body p-4">
              <form method="GET" action="/sales/history" class="row g-3 align-items-end">
                <div class="col-md-4">
                  <label for="saleDate" class="form-label fw-semibold">Selling Date</label>
                  <input
                    type="date"
                    class="form-control"
                    id="saleDate"
                    name="date"
                    value="<%= selectedDate || '' %>"
                  />
                </div>
                <div class="col-md-4">
                  <label for="customerId" class="form-label fw-semibold">Customer Code</label>
                  <input
                    type="text"
                    class="form-control"
                    id="customerId"
                    name="customerId"
                    value="<%= selectedCustomerId || '' %>"
                    placeholder="Enter customer code"
                  />
                </div>
                <div class="col-md-auto">
                  <button type="submit" class="btn btn-primary">Filter</button>
                </div>
                <% if (selectedDate || selectedCustomerId) { %>
                  <div class="col-md-auto">
                    <a href="/sales/history" class="btn btn-outline-secondary">Clear</a>
                  </div>
                <% } %>
              </form>
            </div>
          </div>

          <div class="row g-3 mb-4">
            <div class="col-md-6 col-xl-4">
              <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                  <div class="text-primary fs-3 mb-2"><i class="bi bi-currency-dollar"></i></div>
                  <div class="text-uppercase text-muted small mb-2">
                    <% if (selectedDate || selectedCustomerId) { %>
                      Total Selling Amount
                    <% } else { %>
                      Total Selling Amount (Recent 5)
                    <% } %>
                  </div>
                  <div class="display-6 fw-semibold"><%= totalSalesAmountFormatted %></div>
                </div>
              </div>
            </div>
          </div>

          <% if (typeof successMessage !== 'undefined' && successMessage) { %>
            <div id="sales-success-alert" class="alert alert-success alert-dismissible fade show" role="alert">
              <%= successMessage %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert alert-danger"><%= errorMessage %></div>
          <% } %>

          <div class="card border-0 shadow-sm mb-4 table-card">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <div>
                  <h2 class="h5 fw-semibold mb-1">Add Sales Details</h2>
                  <p class="text-muted mb-0">Enter a product sale and save it to the sales history record.</p>
                </div>
              </div>

              <form method="POST" action="/sales/history" class="row g-3 align-items-end">
                <div class="col-md-3">
                  <label for="product_id" class="form-label fw-semibold">Product</label>
                  <select class="form-select" id="product_id" name="product_id" required>
                    <option value="">Select product</option>
                    <% (products || []).forEach((product) => { %>
                      <option value="<%= product.product_code %>"><%= product.product_code %> - <%= product.name %></option>
                    <% }); %>
                  </select>
                </div>

                <div class="col-md-2">
                  <label for="customer_id" class="form-label fw-semibold">Customer</label>
                  <select class="form-select" id="customer_id" name="customer_id">
                    <option value="">Optional</option>
                    <% (customers || []).forEach((customer) => { %>
                      <option value="<%= customer.customer_code || 'N/A' %>"><%= customer.customer_code || 'N/A' %><% if (customer.customer_name) { %> - <%= customer.customer_name %><% } %></option>
                    <% }); %>
                  </select>
                </div>

                <div class="col-md-2">
                  <label for="quantity" class="form-label fw-semibold">Quantity</label>
                  <input type="number" class="form-control" id="quantity" name="quantity" min="1" step="1" required />
                </div>

                <div class="col-md-2">
                  <label for="unit_price" class="form-label fw-semibold">Unit Price</label>
                  <input type="number" class="form-control" id="unit_price" name="unit_price" min="0.01" step="0.01" required />
                </div>

                <div class="col-md-2">
                  <label for="payment_status" class="form-label fw-semibold">Payment Status</label>
                  <select class="form-select" id="payment_status" name="payment_status" required>
                    <option value="Pending">Pending</option>
                    <option value="Paid">Paid</option>
                    <option value="Partially Paid">Partially Paid</option>
                  </select>
                </div>

                <div class="col-md-1">
                  <button type="submit" class="btn btn-primary w-100">Save</button>
                </div>
              </form>
            </div>
          </div>

          <div class="card border-0 shadow-sm table-card">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div class="fw-semibold">
                  <% if (selectedDate && selectedCustomerId) { %>
                    Showing sales for customer <span class="text-primary"><%= selectedCustomerId %></span> on <span class="text-primary"><%= selectedDate %></span>
                  <% } else if (selectedDate) { %>
                    Showing sales for <span class="text-primary"><%= selectedDate %></span>
                  <% } else if (selectedCustomerId) { %>
                    Showing sales for customer <span class="text-primary"><%= selectedCustomerId %></span>
                  <% } %>
                </div>
                <div class="text-muted small">Total records: <%= totalRecords %></div>
              </div>

              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Product</th>
                      <th>Customer</th>
                      <th>Qty</th>
                      <th>Unit Price</th>
                      <th>Total Amount</th>
                      <th>Payment Status</th>
                      <th>Selling Date</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!salesHistory || !salesHistory.length) { %>
                      <tr>
                        <td colspan="8" class="text-center text-muted py-4">No sales history found for the selected date.</td>
                      </tr>
                    <% } else { %>
                      <% salesHistory.forEach((item) => { %>
                        <tr>
                          <td><%= item.product_name || item.product_id || 'N/A' %></td>
                          <td><%= item.customer_name || item.customer_id || 'N/A' %></td>
                          <td><%= item.quantity %></td>
                          <td><%= item.unit_price_formatted %></td>
                          <td><%= item.total_amount_formatted %></td>
                          <td>
                            <% if (item.payment_status === 'Paid') { %>
                              <span class="badge bg-success-subtle text-success-emphasis"><%= item.payment_status %></span>
                            <% } else if (item.payment_status === 'Partially Paid') { %>
                              <span class="badge bg-warning-subtle text-warning-emphasis"><%= item.payment_status %></span>
                            <% } else { %>
                              <span class="badge bg-secondary-subtle text-secondary-emphasis"><%= item.payment_status %></span>
                            <% } %>
                          </td>
                          <td><%= item.selling_date_label %></td>
                          <td>
                            <button
                              type="button"
                              class="btn btn-sm btn-outline-primary"
                              data-bs-toggle="modal"
                              data-bs-target="#editSaleModal"
                              data-sale-id="<%= item.id %>"
                              data-product-id="<%= item.product_id || '' %>"
                              data-customer-id="<%= item.customer_id || '' %>"
                              data-quantity="<%= item.quantity %>"
                              data-unit-price="<%= item.unit_price %>"
                              data-payment-status="<%= item.payment_status %>"
                            >
                              Update
                            </button>
                          </td>
                        </tr>
                      <% }); %>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>

    <div class="modal fade" id="editSaleModal" tabindex="-1" aria-labelledby="editSaleModalLabel" aria-hidden="true">
      <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
          <form id="editSaleForm" method="POST">
            <div class="modal-header">
              <h5 class="modal-title" id="editSaleModalLabel">Update Sales Record</h5>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body row g-3">
              <div class="col-md-6">
                <label for="editProductId" class="form-label fw-semibold">Product</label>
                <select class="form-select" id="editProductId" name="product_id" required>
                  <option value="">Select product</option>
                  <% (products || []).forEach((product) => { %>
                    <option value="<%= product.product_code %>"><%= product.product_code %> - <%= product.name %></option>
                  <% }); %>
                </select>
              </div>

              <div class="col-md-6">
                <label for="editCustomerId" class="form-label fw-semibold">Customer</label>
                <select class="form-select" id="editCustomerId" name="customer_id">
                  <option value="">Optional</option>
                  <% (customers || []).forEach((customer) => { %>
                    <option value="<%= customer.customer_code || 'N/A' %>"><%= customer.customer_code || 'N/A' %><% if (customer.customer_name) { %> - <%= customer.customer_name %><% } %></option>
                  <% }); %>
                </select>
              </div>

              <div class="col-md-4">
                <label for="editQuantity" class="form-label fw-semibold">Quantity</label>
                <input type="number" class="form-control" id="editQuantity" name="quantity" min="1" step="1" required />
              </div>

              <div class="col-md-4">
                <label for="editUnitPrice" class="form-label fw-semibold">Unit Price</label>
                <input type="number" class="form-control" id="editUnitPrice" name="unit_price" min="0.01" step="0.01" required />
              </div>

              <div class="col-md-4">
                <label for="editPaymentStatus" class="form-label fw-semibold">Payment Status</label>
                <select class="form-select" id="editPaymentStatus" name="payment_status" required>
                  <option value="Pending">Pending</option>
                  <option value="Paid">Paid</option>
                  <option value="Partially Paid">Partially Paid</option>
                </select>
              </div>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
              <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      const successAlert = document.getElementById("sales-success-alert");
      if (successAlert) {
        setTimeout(() => {
          successAlert.classList.add("d-none");
        }, 5000);
      }

      const editSaleModal = document.getElementById("editSaleModal");
      if (editSaleModal) {
        editSaleModal.addEventListener("show.bs.modal", (event) => {
          const button = event.relatedTarget;
          const saleId = button?.dataset.saleId || "";
          const productId = button?.dataset.productId || "";
          const customerId = button?.dataset.customerId || "";
          const quantity = button?.dataset.quantity || "";
          const unitPrice = button?.dataset.unitPrice || "";
          const paymentStatus = button?.dataset.paymentStatus || "Pending";

          const form = document.getElementById("editSaleForm");
          form.action = `/sales/history/${saleId}/update`;
          document.getElementById("editProductId").value = productId;
          document.getElementById("editCustomerId").value = customerId;
          document.getElementById("editQuantity").value = quantity;
          document.getElementById("editUnitPrice").value = unitPrice;
          document.getElementById("editPaymentStatus").value = paymentStatus;
        });
      }
    </script>
  </body>
</html>

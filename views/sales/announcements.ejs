<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
        padding-bottom: 2rem;
      }

      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .card {
        border-radius: 16px;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/sales/dashboard">Sales Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="text-muted small">Signed in as <strong><%= user?.name || 'Sales Team' %></strong></div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Sales Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/sales/dashboard"><i class="bi bi-speedometer2 me-2"></i>Sales Management</a>
              <a class="nav-link px-3 py-2" href="/sales/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/sales/customers"><i class="bi bi-people me-2"></i>Customers</a>
              <a class="nav-link px-3 py-2" href="/sales/history"><i class="bi bi-clock-history me-2"></i>Sales History</a>
              <a class="nav-link px-3 py-2" href="/sales/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/sales/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/sales/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
              <h1 class="h3 fw-semibold mb-1">Announcements</h1>
              <p class="text-muted mb-0">Messages sent by admin for the sales team.</p>
            </div>
            <a href="/sales/dashboard" class="btn btn-outline-primary btn-sm">Back to Dashboard</a>
          </div>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
              <% if (!announcements || !announcements.length) { %>
                <div class="text-center text-muted py-5">No announcements for your sales account yet.</div>
              <% } else { %>
                <div class="d-grid gap-3">
                  <% announcements.forEach((announcement) => { %>
                    <div class="border rounded-4 p-4 bg-light-subtle shadow-sm">
                      <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                        <div>
                          <div class="small text-uppercase text-muted mb-1"><%= announcement.type || 'Sales' %></div>
                          <h2 class="h5 fw-semibold mb-0"><%= announcement.title %></h2>
                        </div>
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                          <span class="badge <%= announcement.is_read ? 'bg-success-subtle text-success-emphasis' : 'bg-primary-subtle text-primary-emphasis' %>">
                            <%= announcement.is_read ? 'Read' : 'Unread' %>
                          </span>
                          <form action="/sales/announcements/<%= announcement.id %>/done" method="POST" class="mb-0">
                            <button type="submit" class="btn btn-sm btn-success">Done</button>
                          </form>
                        </div>
                      </div>
                      <p class="mb-2 text-secondary"><%= announcement.message %></p>
                      <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <span class="badge bg-primary-subtle text-primary-emphasis">
                          <%= new Date(announcement.created_at).toLocaleString() %>
                        </span>
                        <a href="/sales/announcements/<%= announcement.id %>" class="text-decoration-none">View details</a>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

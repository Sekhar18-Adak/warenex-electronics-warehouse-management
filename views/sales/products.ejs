<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }

      .sidebar {
        background: #ffffff;
        border-right: 1px solid #e7ebf0;
        min-height: calc(100vh - 76px);
        position: sticky;
        top: 76px;
        padding-bottom: 2rem;
      }

      .sidebar .nav-link {
        color: #4a5d72;
        border-radius: 10px;
      }

      .sidebar .nav-link:hover,
      .sidebar .nav-link.active {
        background-color: #eef4ff;
        color: #0d6efd;
      }

      .table-card {
        border-radius: 16px;
      }
    </style>
  </head>
  <body>
    <header class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
      <div class="container-fluid px-4 py-3">
        <a class="navbar-brand fw-semibold text-primary" href="/sales/dashboard">Sales Workspace</a>
        <div class="d-flex gap-3 align-items-center">
          <div class="text-muted small">Signed in as <strong><%= user?.name || 'Sales Team' %></strong></div>
          <form action="/logout" method="post" class="mb-0">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </header>

    <div class="container-fluid">
      <div class="row g-0">
        <aside class="col-lg-3 col-xl-2 sidebar p-4">
          <div class="mb-4">
            <div class="small text-uppercase text-muted mb-2">Sales Menu</div>
            <nav class="nav flex-column gap-1">
              <a class="nav-link px-3 py-2" href="/sales/dashboard"><i class="bi bi-speedometer2 me-2"></i>Sales Management</a>
              <a class="nav-link px-3 py-2" href="/sales/products"><i class="bi bi-box-seam me-2"></i>Products</a>
              <a class="nav-link px-3 py-2" href="/sales/customers"><i class="bi bi-people me-2"></i>Customers</a>
              <a class="nav-link px-3 py-2" href="/sales/history"><i class="bi bi-clock-history me-2"></i>Sales History</a>
              <a class="nav-link px-3 py-2" href="/sales/reports"><i class="bi bi-bar-chart me-2"></i>Reports</a>
              <a class="nav-link px-3 py-2" href="/sales/announcements"><i class="bi bi-megaphone me-2"></i>Announcements</a>
              <a class="nav-link px-3 py-2" href="/sales/profile"><i class="bi bi-person-circle me-2"></i>Profile</a>
            </nav>
          </div>
        </aside>

        <main class="col-lg-9 col-xl-10 p-4">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
              <h1 class="h3 fw-semibold mb-1">Product Pricing</h1>
              <p class="text-muted mb-0">Update product buying and selling prices.</p>
            </div>
            <a href="/sales/dashboard" class="btn btn-outline-primary btn-sm">Back to Dashboard</a>
          </div>

          <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>

          <div class="card border-0 shadow-sm table-card">
            <div class="card-body p-3">
              <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Product ID</th>
                      <th>Category</th>
                      <th>Model</th>
                      <th>Buying Price</th>
                      <th>Selling Price</th>
                      <th>Status</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% if (!products || !products.length) { %>
                      <tr>
                        <td colspan="7" class="text-center text-muted py-4">No products found.</td>
                      </tr>
                    <% } else { %>
                      <% products.forEach((product) => { %>
                        <tr>
                          <td><%= product.id %></td>
                          <td><%= product.category %></td>
                          <td><%= product.model %></td>
                          <td>
                            <form action="/sales/products/update/<%= product.id %>" method="post" class="d-flex gap-2 align-items-center">
                              <input type="hidden" name="page" value="<%= currentPage %>" />
                              <input type="hidden" name="field" value="purchase_price" />
                              <input
                                type="number"
                                step="0.01"
                                min="0"
                                class="form-control form-control-sm"
                                name="value"
                                value="<%= product.purchase_price %>"
                                required
                              />
                              <button type="submit" class="btn btn-primary btn-sm">Update</button>
                            </form>
                          </td>
                          <td>
                            <form action="/sales/products/update/<%= product.id %>" method="post" class="d-flex gap-2 align-items-center">
                              <input type="hidden" name="page" value="<%= currentPage %>" />
                              <input type="hidden" name="field" value="selling_price" />
                              <input
                                type="number"
                                step="0.01"
                                min="0"
                                class="form-control form-control-sm"
                                name="value"
                                value="<%= product.selling_price %>"
                                required
                              />
                              <button type="submit" class="btn btn-primary btn-sm">Update</button>
                            </form>
                          </td>
                          <td>
                            <span class="badge <%= product.status === 'Active' ? 'bg-success-subtle text-success-emphasis' : 'bg-secondary-subtle text-secondary-emphasis' %>"><%= product.status %></span>
                          </td>
                          <td>
                            <div class="d-flex gap-2">
                              <a href="/sales/products/view/<%= product.id %>" class="btn btn-outline-primary btn-sm">View</a>
                            </div>
                          </td>
                        </tr>
                      <% }); %>
                    <% } %>
                  </tbody>
                </table>
              </div>

              <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                <div class="text-muted small">Showing <%= products ? products.length : 0 %> of <%= totalProducts %> products</div>

                <div class="d-flex gap-2">
                  <% if (currentPage > 1) { %>
                    <a href="/sales/products?page=<%= currentPage - 1 %>" class="btn btn-outline-primary btn-sm">
                      <i class="bi bi-arrow-left"></i> Previous
                    </a>
                  <% } else { %>
                    <button type="button" class="btn btn-outline-secondary btn-sm" disabled>
                      <i class="bi bi-arrow-left"></i> Previous
                    </button>
                  <% } %>

                  <% if (currentPage < totalPages) { %>
                    <a href="/sales/products?page=<%= currentPage + 1 %>" class="btn btn-primary btn-sm">
                      Next <i class="bi bi-arrow-right"></i>
                    </a>
                  <% } else { %>
                    <button type="button" class="btn btn-secondary btn-sm" disabled>
                      Next <i class="bi bi-arrow-right"></i>
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WareNex | <%= pageTitle %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <style>
      body {
        background: #f5f7fb;
        color: #17324d;
      }
      .profile-card,
      .announcement-card {
        border: 1px solid #e7ebf0;
        border-radius: 18px;
        background: #fff;
      }
      .profile-avatar {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        object-fit: cover;
        background: linear-gradient(135deg, #e2ebff, #f7f9ff);
        border: 3px solid #edf3ff;
      }
      .avatar-placeholder {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        color: #6b7a99;
        background: linear-gradient(135deg, #e2ebff, #f7f9ff);
        border: 3px solid #edf3ff;
      }
      .status-badge {
        font-size: 0.8rem;
        padding: 0.45rem 0.7rem;
        border-radius: 999px;
      }
      .announcement-item {
        border: 1px solid #edf1f5;
        border-radius: 12px;
        background: #f9fbff;
      }
    </style>
  </head>
  <body>
    <nav class="navbar navbar-light bg-white border-bottom px-4 py-3">
      <div class="container-fluid">
        <a class="navbar-brand fw-semibold text-primary" href="/sales/dashboard">Sales Workspace</a>
        <div class="d-flex gap-2 align-items-center">
          <a href="/sales/dashboard" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
          <form action="/logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-primary btn-sm">Logout</button>
          </form>
        </div>
      </div>
    </nav>

    <div class="container py-4">
      <div class="row g-4">
        <div class="col-lg-4">
          <div class="profile-card p-4 shadow-sm">
            <div class="d-flex justify-content-center mb-3">
              <% if (user?.profile_image) { %>
                <img src="<%= user.profile_image %>" alt="Profile image" class="profile-avatar" />
              <% } else { %>
                <div class="avatar-placeholder">
                  <i class="bi bi-person-circle"></i>
                </div>
              <% } %>
            </div>

            <form action="/sales/profile/image" method="post" enctype="multipart/form-data" class="mb-4">
              <label for="profileImage" class="form-label fw-semibold">Profile Image</label>
              <input
                id="profileImage"
                type="file"
                name="profileImage"
                class="form-control"
                accept=".jpg,.jpeg,.png"
              />
              <div class="form-text">Allowed: JPG, JPEG, PNG. Maximum size: 5 MB.</div>
              <button type="submit" class="btn btn-primary w-100 mt-3"><%= user?.profile_image ? 'Update Picture' : 'Add Picture' %></button>
            </form>

            <% if (successMessage) { %>
              <div class="alert alert-success py-2 mb-3"><%= successMessage %></div>
            <% } %>

            <% if (errorMessage) { %>
              <div class="alert alert-danger py-2 mb-3"><%= errorMessage %></div>
            <% } %>

            <div class="text-center">
              <h2 class="h4 fw-bold mb-1"><%= user?.name || 'Sales Team' %></h2>
              <p class="text-muted mb-3"><%= user?.role || 'Sales' %></p>
              <span class="status-badge <%= (user?.status || 'Active') === 'Active' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' %>">
                <%= user?.status || 'Active' %>
              </span>
            </div>
          </div>
        </div>

        <div class="col-lg-8">
          <div class="profile-card p-4 shadow-sm mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h3 class="h4 fw-bold mb-0">Employee Details</h3>
              <i class="bi bi-person-vcard text-primary fs-4"></i>
            </div>
            <div class="row g-3">
              <div class="col-md-6">
                <label class="text-muted small d-block">Full Name</label>
                <div class="fw-semibold"><%= user?.name || 'Not available' %></div>
              </div>
              <div class="col-md-6">
                <label class="text-muted small d-block">Role</label>
                <div class="fw-semibold"><%= user?.role || 'Sales' %></div>
              </div>
              <div class="col-md-6">
                <label class="text-muted small d-block">Email</label>
                <div class="fw-semibold"><%= user?.email || 'Not available' %></div>
              </div>
              <div class="col-md-6">
                <label class="text-muted small d-block">Status</label>
                <div class="fw-semibold"><%= user?.status || 'Active' %></div>
              </div>
            </div>
          </div>

          <div class="announcement-card p-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h3 class="h4 fw-bold mb-0">Announcements</h3>
              <span class="badge bg-primary rounded-pill px-3 py-2"><%= announcementCount %></span>
            </div>

            <% if (announcementCount === 0) { %>
              <div class="text-muted">You have no new announcements from admin.</div>
            <% } else { %>
              <p class="mb-3 text-muted">You have received <strong><%= announcementCount %></strong> announcement<%= announcementCount === 1 ? '' : 's' %> from admin.</p>

              <div class="d-grid gap-3">
                <% announcements.forEach((announcement) => { %>
                  <div class="announcement-item p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <h5 class="mb-0 fw-semibold"><%= announcement.title || 'Announcement' %></h5>
                      <span class="badge bg-light text-secondary"><%= announcement.type || 'Admin' %></span>
                    </div>
                    <p class="mb-2 text-secondary"><%= announcement.message %></p>
                    <small class="text-muted"><%= new Date(announcement.created_at).toLocaleString() %></small>
                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
